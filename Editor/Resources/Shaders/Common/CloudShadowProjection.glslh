// THE SUN-SPACE PROJECTION both cloud shadow maps are built on — the ONE source of truth for where a
// world point lands on a map that answers "how much cloud is between here and the sun".
//
// Compiled THREE times from this same text:
//   * as GLSL by the passes that WRITE the maps (Programs/Clouds/CloudShadowMap.shader, the four-slice
//     in-march map, and Programs/Clouds/CloudWorldShadowMap.shader, the world-readable one);
//   * as GLSL by everything that READS them — the cloud raymarch, and now the deferred lighting pass,
//     the forward mesh shaders, the terrain and the grass;
//   * as C++ by Desert/Tests/Engine/CloudMath/CloudGeometryReference.hpp, which the CloudMath tests drive.
// The restricted GLSL/C++ dialect described at the top of Common/CloudGeometry.glslh applies unchanged:
// no swizzles, no `out` parameters, no arrays, `f`-suffixed literals, functions defined before use.
//
// IT HAS NO DEPENDENCIES, and that is deliberate. A terrain or mesh fragment shader needs the projection
// and nothing else; making it reach through Common/CloudGeometry.glslh to get it would drag twelve hundred
// lines of march arithmetic into every lit surface in the engine, for six functions of dot products.
//
// ---- WHY IT IS PARAMETERISED ON THE SUN, NOT ON THE GROUND -----------------------------------------
//
// Every point on one sun ray must land on one texel — that is the whole property that makes a single
// fetch answer "how much cloud is between me and the sun". So the map's plane is the plane ORTHOGONAL TO
// THE SUN, and a world position projects onto it by dropping its component along the sun. A ground-plane
// (XZ) parameterisation would only have this property with the sun straight overhead, and would smear
// into uselessness exactly at the low sun angles where cloud shadows are most visible.

#ifndef CLOUD_SHADOW_PROJECTION_GLSLH
#define CLOUD_SHADOW_PROJECTION_GLSLH

// An orthonormal basis for the plane orthogonal to the sun. Deterministic and shared: the pass that
// WRITES a map and everything that READS it must agree on it exactly, or every shadow lands somewhere
// other than the cloud that cast it.
//
// The reference axis is swapped near the poles for the same reason CloudConeSampleOffset swaps it —
// cross() with a nearly parallel vector loses all its precision, and a zero-length tangent is a NaN.
vec3 CloudShadowRight(vec3 sunDir)
{
    vec3 reference = abs(sunDir.y) < 0.99f ? vec3(0.0f, 1.0f, 0.0f) : vec3(1.0f, 0.0f, 0.0f);
    return normalize(cross(reference, sunDir));
}

vec3 CloudShadowUp(vec3 sunDir)
{
    return cross(sunDir, CloudShadowRight(sunDir));
}

// Where @p worldPos lands on the map. @p centre is the world point the map is built around (the camera,
// so the covered area follows the viewer) and @p extent is the map's HALF-WIDTH in world units.
//
// Returns UV in [0,1] at the covered area and outside it beyond — the caller decides what to do with a
// sample that has left the map, and CloudShadowInside is how it asks.
vec2 CloudShadowUv(vec3 worldPos, vec3 centre, vec3 sunDir, float extent)
{
    vec3  offset = worldPos - centre;
    float scale  = 0.5f / max(extent, 1.0f);

    float u = dot(offset, CloudShadowRight(sunDir)) * scale + 0.5f;
    float v = dot(offset, CloudShadowUp(sunDir)) * scale + 0.5f;
    return vec2(u, v);
}

// Whether a UV is on the map at all. Sampling outside it would clamp to the border and shadow a point
// with whatever happened to be at the edge, which reads as a hard line across the sky — or, for a world
// receiver, a hard line across the ground.
bool CloudShadowInside(vec2 uv)
{
    return uv.x >= 0.0f && uv.x <= 1.0f && uv.y >= 0.0f && uv.y <= 1.0f;
}

// How much of the map's answer to TRUST at this UV (CLD-103): 1 over the interior, falling linearly to 0
// across the outer tenth. A term that exists inside the map and vanishes outside it draws its own
// boundary in the sky — one cloud straddling the edge got a column-occluded base on the near side and an
// unoccluded one on the far side, a step in brightness along a line no cloud defined. Fading the trust
// out before the edge turns the step into a gradient the eye does not find.
//
// It reaches EXACTLY zero at uv 0 and 1, which is what makes it join continuously onto the "outside the
// map, no shadow at all" answer CloudShadowInside selects: the ground beyond the map's reach falls back
// to full sun smoothly, with no step at the seam.
float CloudShadowEdgeFade(vec2 uv)
{
    float dx = min(uv.x, 1.0f - uv.x);
    float dy = min(uv.y, 1.0f - uv.y);
    return clamp(min(dx, dy) * 10.0f, 0.0f, 1.0f);
}

// The inverse of CloudShadowUv, for the passes that fill a map: the point on the plane through @p centre
// that this texel's sun ray passes through. The ray itself is then that point plus any multiple of the
// sun direction, which is what the shell intersection turns into an entry and an exit.
vec3 CloudShadowPlanePoint(vec2 uv, vec3 centre, vec3 sunDir, float extent)
{
    float span = 2.0f * max(extent, 1.0f);
    float x    = (uv.x - 0.5f) * span;
    float y    = (uv.y - 0.5f) * span;
    return centre + CloudShadowRight(sunDir) * x + CloudShadowUp(sunDir) * y;
}

// HOW FAR ALONG THE SUN RAY a world point sits, measured from the map's plane and INCREASING AWAY FROM
// THE SUN. Negative above the plane when the sun is overhead, positive below it.
//
// This is the coordinate the world-readable encoding is a function of: the map stores the depth at which
// its column first met cloud, and a receiver answers "how much of that column is above ME" by comparing
// its own depth against it. The sign convention is the one that makes "deeper = more cloud above".
float CloudShadowDepthAlongSun(vec3 worldPos, vec3 centre, vec3 sunDir)
{
    return -dot(worldPos - centre, sunDir);
}

#endif // CLOUD_SHADOW_PROJECTION_GLSLH
