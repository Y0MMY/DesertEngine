// THE volumetric-cloud parameter block, byte for byte. Declared once, included by every cloud pass that
// needs it (the weather-map generator, the shadow map, the raymarch and the temporal resolve), so they can
// never disagree about the layout.
//
// The C++ side of this layout is Graphic::CloudGpuPayload / Graphic::CloudLayerPayload
// (Engine/Graphic/Clouds/CloudPayload.hpp). The two are kept in step by static_asserts on every offset
// there plus a unit test on sizeof/offsetof — the SkyUBData-style silent mirror divergence is a corrupted
// frame with no error message, and it is exactly what a layout declared twice produces the first time
// somebody inserts a field in the middle of one of them.
//
// Raw `layout(std430, ...)` rather than the ReadBuffer(n) sugar, deliberately: the sugar is expanded by
// the engine's own parser, and this header is also fed straight to glslc during development to prove the
// shaders compile. Raw layout is the sanctioned escape for structural GLSL.
//
// LAYOUT RULES that make the mirror trivial: in each block, every vec4 comes first, every scalar after.
// std430 gives a vec4 a 16-byte alignment and a float or int a 4-byte one, and C++ agrees on both, so a
// run of vec4s followed by a run of 4-byte scalars has the same offsets in both languages. The one place
// they disagree is TAIL PADDING — std430 rounds a struct up to 16 and C++ (with glm's 4-byte-aligned
// vec4) does not — so both blocks below close on explicit padding rather than on the compiler's opinion.
//
// UNITS: every distance is in WORLD UNITS (centimetres) exactly as the component authors it. The
// kilometre space the shell intersection needs is entered inside the raymarch, once, through
// Common/CloudGeometry.glslh — not here, so that nothing has to ask which of the two a member is in.
//
// ---- TWO LAYERS -------------------------------------------------------------------------------------
//
// A sky has a deck low down and thin sheets high above it (Nubis3 pp. 125/126/150), and one shell cannot
// be both. So the block carries an ARRAY of layer parameters and each pass calls CloudSelectLayer to
// choose one; every accessor below then reads the copy that call made.
//
// The names are unchanged. `u_Coverage` still means "the coverage of the layer being marched right now",
// and the ~4000 lines of density, shading and weather code that use these names did not have to move.
// That is the whole reason the selection is a macro table instead of a rename: a rename produces a diff
// nobody can review, and it would break the whole-word consumer check the SettingConsumers suite runs
// over Engine/Graphic/Clouds/CloudPayload.hpp.

#ifndef CLOUD_PARAMS_GLSLH
#define CLOUD_PARAMS_GLSLH

// The binding the cloud parameter buffer is bound at, in EVERY cloud pass. ComputePipeline's
// SetStorageBuffer takes the binding as an explicit argument and does not consult reflection, so this
// number and Graphic::kCloudParamsBinding have to be the same one — a mismatch does not fail, it lands
// the buffer on another descriptor (VUID-VkWriteDescriptorSet-descriptorType-00319 at best, someone
// else's data at worst).
#define CLOUD_PARAMS_BINDING 2

// Mirrors Graphic::kCloudMaxLayers. The weather map, the profile map, the profile table and the cloud
// shadow map are all volumes this deep — one slice per layer — so this number is also the depth of four
// images, and CloudLayerSliceW (Common/CloudGeometry.glslh) is how a layer index becomes the w that
// samples its own slice exactly.
#define CLOUD_MAX_LAYERS 2

// ONE LAYER. Mirrors Graphic::CloudLayerPayload member for member; see the offsets asserted there.
struct CloudLayerBlock
{
    // ---- vec4s -------------------------------------------------------------------------------------
    // Colours are LINEAR. The `.w` of each carries a named companion scalar rather than padding.
    vec4 ScatteringAlbedo;      // rgb = single-scattering albedo,           w = AmbientHeightBias
    vec4 ExtinctionTint;        // rgb = per-channel extinction tint,        w = ExtinctionScale
    vec4 SunTint;               // rgb = artistic tint of the lit side,      w = PrecipitationDarkening
    vec4 ShadowTint;            // rgb = artistic tint of the shadowed side, w = AtmosphericPerspective
    vec4 StratusGradient;       // base-in start/end, top-out start/end, normalized layer height
    vec4 StratocumulusGradient; // the same four heights for stratocumulus
    vec4 CumulusGradient;       // the same four heights for cumulus

    // ---- Cloud Layer -------------------------------------------------------------------------------
    float LayerBottomAltitude;
    float LayerThickness;
    float MaxViewDistance;
    float HorizonFadeStart;
    float HorizonFadeEnd;

    // ---- Weather -----------------------------------------------------------------------------------
    float Coverage;
    float CoverageContrast;
    float WeatherTileSize;
    float WeatherWarpStrength;
    float CloudType;
    float CloudTypeVariance;
    float AnvilBias;
    float Wetness;

    // ---- Shape -------------------------------------------------------------------------------------
    float ShapeTileSize;
    float BaseShapeRemapMin;
    float ShapeErosionStrength;
    float BaseGradientPower;
    float TopGradientPower;
    float DensityHeightBias;

    // ---- Detail ------------------------------------------------------------------------------------
    float DetailStrength;
    float DetailTileSize;
    float DetailTypeBias;
    float BillowGradientPower;
    float BillowNoiseScale;
    float HighFreqStrength;
    float HighFreqWispSharpness;
    float HighFreqBillowSharpness;
    float HighFreqFeatureSize;
    float CurlStrength;
    float CurlTileSize;
    float DensitySharpenLow;
    float DensitySharpenHigh;
    float DensityScalePower;
    float DistanceSoftening;
    float SofteningStartDistance;
    float SofteningEndDistance;
    float NearFadeStart;
    float NearFadeEnd;
    float NearFadeMinDensity;

    // ---- Lighting ----------------------------------------------------------------------------------
    // The first three are the multipliers on the SHARED sun and sky radiances. The radiances are one per
    // frame; how much of each a layer takes is the layer's own business.
    float SunLightIntensityScale;
    float AmbientSkyContribution;
    float AmbientGroundContribution;
    float LightMarchDistance;
    float LightConeSpread;
    float PhaseForwardG;
    float PhaseBackwardG;
    float PhaseBlend;
    float SilverLiningIntensity;
    float PowderStrength;
    float PowderScale;
    float MultiScatterExtinctionFalloff;
    float MultiScatterScatterFalloff;
    float MultiScatterPhaseFalloff;
    float DistanceFadeStart;
    float DistanceFadeEnd;

    // ---- Animation ---------------------------------------------------------------------------------
    float AnimationSpeed;
    float WindInfluence;
    float WindDirectionOffset; // degrees, applied about the world up axis
    float ShapeScrollMultiplier;
    float DetailScrollMultiplier;
    float WeatherScrollMultiplier;
    float WindHeightShear;
    float WindUpliftSpeed;

    // ---- Quality: the step schedule for THIS shell -------------------------------------------------
    float MinStepSize;
    float MaxStepSize;
    float StepGrowthRate;
    float CoarseStepMultiplier;

    int WeatherSeed;
    int WeatherOctaves;
    // This layer's OWN step budget, not the ray's. A ray that crosses a deck and then a sheet spends at
    // most MaxSteps in each, so a dense deck met first cannot leave the sheet above it unmarched.
    int MaxSteps;
    int EmptySamplesBeforeCoarse;
    int LightMarchSamples;
    int MultiScatterOctaves;

    float AmbientOcclusion;
    int   AutoDistanceFade;
    float CloudShadowExtent;
    int   CloudShadowEnabled;
    float CloudHeightVariance;

    // std430 rounds a struct up to its own 16-byte alignment before arraying it. Written out so the C++
    // mirror can assert the same size instead of hoping its compiler chose the same tail.
    float Pad0;
    float Pad1;
};

layout(std430, binding = CLOUD_PARAMS_BINDING) readonly buffer CloudParamsBuffer
{
    // ---- SHARED vec4s ------------------------------------------------------------------------------
    // One sun, one sky, one wind. The `.w` of the three radiances is unused — their multipliers are per
    // layer above — and stays a vec4 because std430 gives a vec3 a 16-byte alignment anyway.
    vec4 u_SunDirection;   // xyz = TOWARD the sun (normalized), w = sun angular radius, radians
    vec4 u_SunIrradiance;  // rgb = sun radiance from the atmosphere
    vec4 u_ZenithRadiance; // rgb = sky ambient from above
    vec4 u_GroundRadiance; // rgb = ground-bounce ambient from below
    vec4 u_SceneWind;      // xyz = the SCENE's wind velocity (world units/s), w = time in seconds

    // ---- SHARED scalars ----------------------------------------------------------------------------
    float u_PlanetRadius; // world units; from the atmosphere, never authored by the cloud component

    // The three that belong to the RAY and to the HISTORY rather than to a shell: there is one ray per
    // pixel and one history pair per view. The renderer reads them from the primary (lowest) layer.
    // Temporal MODE is not here: it decides whether that stage runs at all and which image the composite
    // binds, which is a decision the CPU makes once — a copy of it in this block would be a second answer
    // to the same question, free to disagree with the first.
    float u_JitterStrength;
    float u_TemporalBlendFactor;
    float u_TemporalClampScale;

    // How many entries of u_CloudLayers are live. Read by the WEATHER and SHADOW passes, which are
    // dispatched one workgroup deep per layer and clamp their z to it. The RAYMARCH does not read it: its
    // layer count arrives as a specialization constant so the branch on it can be folded away, and both
    // numbers come from Graphic::VolumetricCloudRenderer::m_Layers.Count.
    int u_LayerCount;

    // HERO CLOUDS: how many records of the instance buffer at binding 14 are live, and how many of that
    // leading run cast a cloud shadow. Two counts and not a per-instance flag, because the two passes
    // march different subsets and the renderer can sort the shadow casters to the front once per frame
    // instead of testing a flag once per sample. Zero means no scene entity placed a Cloud Volume, and
    // the union in Common/CloudDensityCompose.glslh then costs one uniform branch.
    //
    // They are SHARED and not per layer: a hero cloud is placed in the WORLD, and which shell it falls in
    // is a question its own bounds already answer.
    int u_VoxelInstanceCount;
    int u_VoxelShadowCount;

    // Closes the head on the 16-byte boundary std430 gives the array below.
    int u_ParamsPad0;

    CloudLayerBlock u_CloudLayers[CLOUD_MAX_LAYERS];
};

// THE ACTIVE LAYER: an index, set by CloudSelectLayer, which every accessor below reads through.
//
// Every entry point must call CloudSelectLayer before it reads anything below. A shader global is
// per-invocation, so this is a local choice with a global's spelling — which is what is wanted, because
// which shell a pixel is marching is a per-pixel fact.
//
// WHERE THAT CALL GOES IS A PERFORMANCE DECISION, and it is the one thing to know before editing any
// caller. The index is memory the optimiser will not promote across a loop, so a parameter read inside a
// loop that also assigns the index keeps a computed address and cannot be hoisted out of the march —
// and a density sample makes about fifty of them. Measured on the shipped Half-resolution showcase,
// interleaved, minimum of three runs, against 8.635 ms a frame for the same scene before cloud layers
// existed at all:
//
//   selection OUTSIDE every loop, one layer     8.542 ms   <- what a one-layer scene must take
//   selection inside the segment loop          11.783 ms
//   a per-segment branch inlining the march
//     twice inside one loop                    13.640 ms   <- both copies live at once; worse, not better
//   copying the whole block into a local       (worse still: 432 bytes into per-lane registers)
//
// Programs/Clouds/CloudRaymarch.shader therefore keeps TWO segment loops that differ only in where this
// call sits, and picks between them on the layer count. See the note there.
//
// AND THE LAST 1.2 ms OF IT NEEDED THE LOOP TO STOP EXISTING, not to stop running. Two loops still left a
// one-layer scene at 9.80 ms because a store to this index in the branch NOT taken is a store the
// optimiser still has to assume: the parameter loads keep a computed address and stay inside the march.
// The raymarch's layer count is now a SPECIALIZATION CONSTANT (`layout(constant_id = 0)` there), so the
// driver folds the test and deletes the branch — and with it the only other writer of this variable —
// before it compiles the module. One SPIR-V module, one pipeline per layer count, no permutation system.
//
// The one thing the index answers that a copy of the parameters could not: which SLICE of the per-layer
// volumes to sample. See CloudActiveLayerSliceW below.
int g_CloudLayerIndex = 0;

void CloudSelectLayer(int layer)
{
    g_CloudLayerIndex = clamp(layer, 0, CLOUD_MAX_LAYERS - 1);
}

#define CLOUD_LAYER u_CloudLayers[g_CloudLayerIndex]

// ---- The accessor table ---------------------------------------------------------------------------
//
// One line per field, and the ONLY place the layer indirection appears. Everything downstream goes on
// spelling the parameter the way it always did.

#define u_ScatteringAlbedo      CLOUD_LAYER.ScatteringAlbedo
#define u_ExtinctionTint        CLOUD_LAYER.ExtinctionTint
#define u_SunTint               CLOUD_LAYER.SunTint
#define u_ShadowTint            CLOUD_LAYER.ShadowTint
#define u_StratusGradient       CLOUD_LAYER.StratusGradient
#define u_StratocumulusGradient CLOUD_LAYER.StratocumulusGradient
#define u_CumulusGradient       CLOUD_LAYER.CumulusGradient

#define u_LayerBottomAltitude CLOUD_LAYER.LayerBottomAltitude
#define u_LayerThickness      CLOUD_LAYER.LayerThickness
#define u_MaxViewDistance     CLOUD_LAYER.MaxViewDistance
#define u_HorizonFadeStart    CLOUD_LAYER.HorizonFadeStart
#define u_HorizonFadeEnd      CLOUD_LAYER.HorizonFadeEnd

#define u_Coverage            CLOUD_LAYER.Coverage
#define u_CoverageContrast    CLOUD_LAYER.CoverageContrast
#define u_WeatherTileSize     CLOUD_LAYER.WeatherTileSize
#define u_WeatherWarpStrength CLOUD_LAYER.WeatherWarpStrength
#define u_CloudType           CLOUD_LAYER.CloudType
#define u_CloudTypeVariance   CLOUD_LAYER.CloudTypeVariance
#define u_AnvilBias           CLOUD_LAYER.AnvilBias
#define u_Wetness             CLOUD_LAYER.Wetness

#define u_ShapeTileSize        CLOUD_LAYER.ShapeTileSize
#define u_BaseShapeRemapMin    CLOUD_LAYER.BaseShapeRemapMin
#define u_ShapeErosionStrength CLOUD_LAYER.ShapeErosionStrength
#define u_BaseGradientPower    CLOUD_LAYER.BaseGradientPower
#define u_TopGradientPower     CLOUD_LAYER.TopGradientPower
#define u_DensityHeightBias    CLOUD_LAYER.DensityHeightBias

#define u_DetailStrength          CLOUD_LAYER.DetailStrength
#define u_DetailTileSize          CLOUD_LAYER.DetailTileSize
#define u_DetailTypeBias          CLOUD_LAYER.DetailTypeBias
#define u_BillowGradientPower     CLOUD_LAYER.BillowGradientPower
#define u_BillowNoiseScale        CLOUD_LAYER.BillowNoiseScale
#define u_HighFreqStrength        CLOUD_LAYER.HighFreqStrength
#define u_HighFreqWispSharpness   CLOUD_LAYER.HighFreqWispSharpness
#define u_HighFreqBillowSharpness CLOUD_LAYER.HighFreqBillowSharpness
#define u_HighFreqFeatureSize     CLOUD_LAYER.HighFreqFeatureSize
#define u_CurlStrength            CLOUD_LAYER.CurlStrength
#define u_CurlTileSize            CLOUD_LAYER.CurlTileSize
#define u_DensitySharpenLow       CLOUD_LAYER.DensitySharpenLow
#define u_DensitySharpenHigh      CLOUD_LAYER.DensitySharpenHigh
#define u_DensityScalePower       CLOUD_LAYER.DensityScalePower
#define u_DistanceSoftening       CLOUD_LAYER.DistanceSoftening
#define u_SofteningStartDistance  CLOUD_LAYER.SofteningStartDistance
#define u_SofteningEndDistance    CLOUD_LAYER.SofteningEndDistance
#define u_NearFadeStart           CLOUD_LAYER.NearFadeStart
#define u_NearFadeEnd             CLOUD_LAYER.NearFadeEnd
#define u_NearFadeMinDensity      CLOUD_LAYER.NearFadeMinDensity

#define u_SunLightIntensityScale        CLOUD_LAYER.SunLightIntensityScale
#define u_AmbientSkyContribution        CLOUD_LAYER.AmbientSkyContribution
#define u_AmbientGroundContribution     CLOUD_LAYER.AmbientGroundContribution
#define u_LightMarchDistance            CLOUD_LAYER.LightMarchDistance
#define u_LightConeSpread               CLOUD_LAYER.LightConeSpread
#define u_PhaseForwardG                 CLOUD_LAYER.PhaseForwardG
#define u_PhaseBackwardG                CLOUD_LAYER.PhaseBackwardG
#define u_PhaseBlend                    CLOUD_LAYER.PhaseBlend
#define u_SilverLiningIntensity         CLOUD_LAYER.SilverLiningIntensity
#define u_PowderStrength                CLOUD_LAYER.PowderStrength
#define u_PowderScale                   CLOUD_LAYER.PowderScale
#define u_MultiScatterExtinctionFalloff CLOUD_LAYER.MultiScatterExtinctionFalloff
#define u_MultiScatterScatterFalloff    CLOUD_LAYER.MultiScatterScatterFalloff
#define u_MultiScatterPhaseFalloff      CLOUD_LAYER.MultiScatterPhaseFalloff
#define u_DistanceFadeStart             CLOUD_LAYER.DistanceFadeStart
#define u_DistanceFadeEnd               CLOUD_LAYER.DistanceFadeEnd

#define u_AnimationSpeed          CLOUD_LAYER.AnimationSpeed
#define u_WindInfluence           CLOUD_LAYER.WindInfluence
#define u_WindDirectionOffset     CLOUD_LAYER.WindDirectionOffset
#define u_ShapeScrollMultiplier   CLOUD_LAYER.ShapeScrollMultiplier
#define u_DetailScrollMultiplier  CLOUD_LAYER.DetailScrollMultiplier
#define u_WeatherScrollMultiplier CLOUD_LAYER.WeatherScrollMultiplier
#define u_WindHeightShear         CLOUD_LAYER.WindHeightShear
#define u_WindUpliftSpeed         CLOUD_LAYER.WindUpliftSpeed

#define u_MinStepSize             CLOUD_LAYER.MinStepSize
#define u_MaxStepSize             CLOUD_LAYER.MaxStepSize
#define u_StepGrowthRate          CLOUD_LAYER.StepGrowthRate
#define u_CoarseStepMultiplier    CLOUD_LAYER.CoarseStepMultiplier
#define u_WeatherSeed             CLOUD_LAYER.WeatherSeed
#define u_WeatherOctaves          CLOUD_LAYER.WeatherOctaves
#define u_MaxSteps                CLOUD_LAYER.MaxSteps
#define u_EmptySamplesBeforeCoarse CLOUD_LAYER.EmptySamplesBeforeCoarse
#define u_LightMarchSamples       CLOUD_LAYER.LightMarchSamples
#define u_MultiScatterOctaves     CLOUD_LAYER.MultiScatterOctaves

#define u_AmbientOcclusion    CLOUD_LAYER.AmbientOcclusion
#define u_AutoDistanceFade    CLOUD_LAYER.AutoDistanceFade
#define u_CloudShadowExtent   CLOUD_LAYER.CloudShadowExtent
#define u_CloudShadowEnabled  CLOUD_LAYER.CloudShadowEnabled
#define u_CloudHeightVariance CLOUD_LAYER.CloudHeightVariance

// The w coordinate that samples the ACTIVE layer's slice of the four per-layer volumes (weather map,
// profile map, profile table, cloud shadow map). The arithmetic itself is CloudLayerSliceW in
// Common/CloudGeometry.glslh, where the CloudMath tests drive it as C++ and pin that it lands on a texel
// centre — a coordinate half a texel off would blend one layer's weather into the other's.
float CloudActiveLayerSliceW()
{
    return CloudLayerSliceW(g_CloudLayerIndex, CLOUD_MAX_LAYERS);
}

// The wind the CLOUDS drift with: the scene's single shared wind, scaled by the layer's own influence
// and rotated by its own offset. There is exactly one wind in the engine (SceneSettings) and each cloud
// layer contributes a multiplier and an angle to it — never a second direction, or the grass and the
// sky would blow different ways. A high sheet taking a larger Wind Influence than the deck under it is
// wind SHEAR, which is what makes cirrus streak while the cumulus below barely moves.
vec3 CloudWindVelocity()
{
    float a = radians(u_WindDirectionOffset);
    float s = sin(a);
    float c = cos(a);
    vec3  w = vec3(u_SceneWind.x, u_SceneWind.y, u_SceneWind.z) * u_WindInfluence;
    return vec3(w.x * c - w.z * s, w.y, w.x * s + w.z * c);
}

// Animated time. AnimationSpeed at 0 freezes the layer without freezing anything else in the frame.
float CloudTime()
{
    return u_SceneWind.w * u_AnimationSpeed;
}

#endif // CLOUD_PARAMS_GLSLH
