// THE cloud parameter block, byte for byte. The C++ side of this layout is Graphic::CloudGpuPayload
// (Engine/Graphic/Clouds/CloudPayload.hpp), where a static_assert pins every offset. A layout declared
// twice diverges the first time somebody inserts a field into the middle of one of them, and the failure
// mode is a corrupted frame with no error message — the asserts turn it into a build error instead.
//
// Raw `layout(std430, ...)` rather than the ReadBuffer(n) sugar, for the reason FogParams.glslh gives:
// this header describes a structure, and raw layout is the sanctioned escape for structural GLSL.
//
// UNITS: KILOMETRES throughout, already converted on the C++ side by PackCloudParams. Nothing in this
// block is in world units, and nothing downstream converts a second time.
//
// EVERY SLOT HAS A CONSUMER. The block is packed to exactly 63 floats with no padding and no
// reserved field, because a slot nobody reads is a dead setting wearing a parameter's
// clothes — and the first person to need a new one will quietly repurpose it. Phase Э5 is what that
// rule looks like when it bites: the coverage, its contrast and its tile moved to the BAKE, so rather
// than travel to a march that would not read them they left the block, and the region took their slot.
//
// FIELDS ARE APPENDED, NEVER INSERTED. Every offset here is a promise to the shader; a field placed in
// the middle silently reinterprets every field after it.

#ifndef CLOUD_PARAMS_GLSLH
#define CLOUD_PARAMS_GLSLH

// ComputePipeline::SetStorageBuffer takes the binding as an explicit argument and never consults the
// shader's reflection, so this number and Graphic::kCloudParamsBinding must be the same one. A mismatch
// lands the buffer on a different descriptor rather than on an error.
#define CLOUD_PARAMS_BINDING 1

layout( std430, binding = CLOUD_PARAMS_BINDING ) readonly buffer CloudParamsBuffer
{
    vec4  u_CloudLayer;     // x planet radius (km), y layer bottom altitude (km), z thickness (km), w max view distance (km)
    // w is the LAYER's extinction now, without any species' factor folded into it: with up to four kinds
    // of cloud in one shell the factor became a property of the sample and travels in CloudFieldSample.
    vec4  u_CloudMarch;     // x max steps, y stop transmittance, z tracing start distance (km), w extinction (1/km)
    // THE MODELLING VOLUME'S REGION, IN THE SLOT THE WEATHER SETTINGS VACATED. Three of the four numbers
    // that stood here — the coverage tile, the coverage and its contrast — decided WHERE cloud is, and all
    // three are consumed by the BAKE now (Assets::BakeCloudProceduralVolume); sending them to a march that
    // would not read them would be three dead slots in a block whose whole discipline is that every slot
    // has a consumer. The fourth, the erosion's period, is still read here and stayed put.
    //
    // xy the region's minimum corner in world kilometres, SNAPPED to the lump lattice; z the RECIPROCAL of
    // its horizontal side; w the erosion's period in kilometres.
    vec4  u_CloudRegion;
    // w is HOW MANY SPECIES this layer carries, 0..4, and it is the bound of the march's per-species loop.
    // It is a count rather than a mask because the slots are filled from the front by PackCloudParams.
    vec4  u_CloudDetail;    // x detail strength, y density scale, z scattering albedo, w species count
    vec4  u_CloudWind;      // xyz accumulated wind offset (km), w phase g
    vec4  u_CloudSun;       // xyz TOWARD the sun (normalized), w light march distance (km)
    vec4  u_CloudSunColour; // rgb sun irradiance (linear), w light march sample count
    // rgb: in the ARTISTIC gradient model this IS the ambient sky radiance; in the PHYSICAL model it is
    // the SCALE applied to the marched distant-sky-light texel, whose value lives on the GPU and never
    // reaches the CPU. w says which: 1 when the texel must be sampled, 0 when rgb is already the value.
    // Same arrangement as the height fog's u_FogAmbient, and for the same reason.
    vec4  u_CloudAmbient;
    vec4  u_CloudMultiScatter; // x octave count, y contribution, z occlusion, w eccentricity
    // x = second phase lobe g, y = phase blend, z = ambient occlusion strength,
    // w = the distance past which the layer is not traced at all (km).
    vec4  u_CloudPhase;
    // x = distance at which the aerial perspective starts to apply (km), y = distance over which it
    // reaches full strength (km), z = distance at which the near-camera fade ends (km), w = the
    // distance at which it begins (km).
    vec4  u_CloudFade;
    // THE FOUR SPECIES, one entry each: x DetailCharacter, y DetailFactor, z DensityFactor,
    // w ExtinctionFactor — what that kind of cloud is MADE OF, taken by whichever species wins the union
    // at a sample and never averaged across them.
    //
    // THE PER-SPECIES PLACEMENT BASIS THAT STOOD BESIDE THIS ARRAY IS GONE, and it is not that it moved:
    // it told the march how to read the coverage noise in each species' own frame, and there is no
    // coverage noise. The lumps of the modelling volume are placed on a lattice in that same frame, on the
    // CPU, at bake time. Four vec4s left the block with it.
    //
    // Slots at or past u_CloudDetail.w are zero and are never read: the loop stops at the count, and the
    // modelling volume's channel for an empty slot is zero everywhere anyway.
    vec4  u_CloudSpeciesEdge[4];
    // x = aerial-perspective volume far extent (km), y = its read-side view-distance scale,
    // z = 1 when the volume exists and must be sampled.
    //
    // A vec3 AND THE LAST MEMBER, which is the only shape in which three values can be three values. It
    // used to be a vec4 whose fourth slot carried the cloud type's variance, and then the domain warp's
    // amount; the warp was measured and taken out (see the note in Common/CloudField.glslh), so rather
    // than leave a float nobody reads — which is where the next parameter would get stashed without a
    // name, a range or a tooltip — the block ends in a vec3. std430 puts it at offset 240 and the block
    // is 252 bytes; Graphic::CloudGpuPayload pins exactly that with a static_assert.
    vec3  u_CloudAerial;
};

// The block is ELEVEN vec4s, a vec4[4] and a vec3, and it stops there. Seeds and octave counts are absent
// on purpose: they decide what the baked volumes CONTAIN, not how the march reads them, so they belong to
// the generators and would be four values copied into every dispatch here for nothing.

// THE STEP SCHEDULE IS NOT HERE ANY MORE. CLOUD_MIN_STEPS and CLOUD_DISTANCE_TO_MAX_STEPS_KM used to be
// declared in this file, beside the parameter block, and their two siblings — the coarse multiplier and
// the empty-sample count — already lived in Common/CloudGeometry.glslh for a reason this pair shares: a
// uniform block cannot be compiled as C++, so a constant declared here can only ever be PARSED OUT OF THE
// FILE AS TEXT by a test, never driven. Desert/Tests/Engine/CloudGeometry did exactly that, and the
// arrangement hid a relation that text cannot express — that the schedule's step has to resolve the cloud
// the library places. All four now live together in CloudGeometry.glslh, which that suite compiles.

// Builds the shell this frame marches. Requires Common/CloudGeometry.glslh.
CloudLayer CloudUnpackLayer()
{
    return CloudMakeLayer( u_CloudLayer.x, u_CloudLayer.y, u_CloudLayer.z );
}

// Builds the producer's parameters. Requires Common/CloudField.glslh.
CloudFieldParams CloudUnpackFieldParams()
{
    CloudFieldParams p;
    p.DetailTileKm   = u_CloudRegion.w;
    p.DetailStrength = u_CloudDetail.x;
    p.DensityScale   = u_CloudDetail.y;
    p.SpeciesCount   = int( clamp( u_CloudDetail.w, 0.0f, float( CLOUD_SPECIES_SLOTS ) ) );

    for ( int slot = 0; slot < CLOUD_SPECIES_SLOTS; ++slot )
        p.SpeciesEdge[slot] = u_CloudSpeciesEdge[slot];

    p.RegionOriginKm  = vec2( u_CloudRegion.x, u_CloudRegion.y );
    p.InvRegionSizeKm = u_CloudRegion.z;

    p.WindOffsetKm = vec3( u_CloudWind.x, u_CloudWind.y, u_CloudWind.z );
    return p;
}

#endif // CLOUD_PARAMS_GLSLH
