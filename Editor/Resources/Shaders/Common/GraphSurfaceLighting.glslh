// THE shading of a LIT shader-graph surface — and it contains no lighting formula of its own.
//
// Everything below the bindings is a CALL into a text the rest of the engine already compiles:
// Mesh/AmbientIBL.glslh for the ambient, Mesh/DirectLighting.glslh for the sun and for every
// analytic light, Mesh/PointLight.glslh and Mesh/Spotlight.glslh for the two punctual light models,
// Common/CloudShadowReceiver.glslh for the cloud layer's shadow on the sun. That is the whole point
// of the file and the reason it is a file.
//
// What was here before was a formula, written by the graph compiler into every generated shader:
//
//     vec3 shaded = albedo.rgb * ( vec3( 0.12 ) + max( dot( N, L ), 0.0 ) * lightCol );
//
// Three defects this project had already found and fixed elsewhere were alive in that one line, and
// they were alive because the line was a fourth copy of a model that lives in three shared texts:
//
//   * `vec3( 0.12 )` is a flat ambient constant that reads no environment at all — the same shape as
//     the deferred composite's `vec3( 0.08 )` that Р16 removed after the owner saw ground and
//     buildings almost black under a bright sky;
//   * the Lambert term is `albedo * cos` and not `albedo / PI * cos` — the same missing PI that made
//     the forward mesh sun PI times too bright until Р20, and which made the sun disagree with a
//     point light of equal intensity standing beside it;
//   * there is no CloudShadowFactor anywhere in it, so a graph material stood in full sun under a
//     cloud deck that was shading every other surface in the frame — the state Р21 found the whole
//     forward path in.
//
// A graph material is authored by an artist who ticked a box called "Lit". If ticking it produces a
// different lighting model from every other lit surface in the scene, the artist learns that from
// the picture, which is the most expensive place to learn anything.
//
// ------------------------------------------------------------------------------------------------
// WHAT IS NOT HERE, and why it is not an oversight.
//
// CASCADED SHADOWS. `ShadowFactor` is NOT a shared text: it exists as three separate copies, inside
// Programs/PBR/StaticMeshPBR.shader, Programs/PBR/SkinnedMeshPBR.shader and
// Programs/Deferred/DeferredLighting.shader. Including a fourth copy here to give the graph geometry
// shadows would create exactly the defect this file exists to remove. The C++ half is already done —
// MeshRenderer::FrameState::ApplyTo writes ShadowUB and binds u_ShadowMap0..3 to any material that
// declares them, generic materials included — so extracting those three copies into one header is a
// GLSL-only change, and the graph picks it up by adding two lines here. Until then a graph material
// receives the cloud's shadow and not the geometry's, and the difference is stated in the Node Graph
// panel beside the Lit checkbox rather than left for a frame to reveal.
//
// THE LIGHTING DEBUG VIEWS. Show Normals and Light Debug are driven by ShadowUB's u_DebugParams,
// which is cascade state; they follow the cascades.

#ifndef GRAPH_SURFACE_LIGHTING_GLSLH
#define GRAPH_SURFACE_LIGHTING_GLSLH

// The BRDF pieces (PI, DistributionGGX, VisibilitySmith, fresnelSchlick) every text below needs, and
// the analytic-light models. PointLight/Spotlight declare their own storage buffers (bindings 6 and
// 16) and pull in DirectLighting themselves; naming it here as well is deliberate, because this file
// calls EvaluateDirectionalLight directly.
#include <Mesh/PBRFunctions.glslh>
#include <Mesh/LightsMetadata.glslh>
#include <Mesh/PointLight.glslh>
#include <Mesh/Spotlight.glslh>
#include <Mesh/DirectLighting.glslh>
#include <Common/DirectionLightsUB.glslh>

// The IBL trio, at the SAME slot numbers the mesh shaders use. The numbers are not shared through
// any header — Mesh/AmbientIBL.glslh declares no binding on purpose, because its four consumers each
// have a different layout — so keeping one slot per thing across all of them is what makes a
// descriptor mismatch readable when one happens.
Uniform(8) samplerCube u_EnvSpecularTex;
Uniform(9) samplerCube u_EnvIrradianceTex;
Uniform(10) sampler2D u_BRDFLUTTexture;

// Included HERE and not above because it names the three bindings just declared.
#include <Mesh/AmbientIBL.glslh>

// The cloud layer's shadow, at the same 20/21 the four mesh shaders and the terrain use.
Uniform(20) sampler2D u_CloudShadowMap;
Uniform(21) CloudShadowUB
{
	mat4 u_CloudShadowWorldToMap;
	// x = the kilometres the map's clip z spans, y = 1 when the map is real and must be read,
	// z = the UV width of the border fade, w = the artist's shadow strength.
	vec4 u_CloudShadowParams;
};

// Included HERE and not above because it names the two bindings just declared.
#include <Common/CloudShadowReceiver.glslh>

// Normal-incidence reflectance of a dielectric — the same 0.04 every other surface shader in this
// engine mixes toward albedo by metalness.
const vec3 GRAPH_FDIELECTRIC = vec3(0.04);

// The whole lit response of a graph surface.
//
//   worldPos  — world-space shading position (centimetres, like everything else in this engine);
//   N         — unit world-space normal;
//   view      — unit vector from the surface toward the eye;
//   albedo    — linear base colour from the graph's Albedo pin;
//   metalness — the graph's Metallic pin;
//   roughness — the graph's Roughness pin, clamped here for the same reason StaticMeshPBR clamps it:
//               the GGX NDF divides by it and a mirror-smooth surface would blow up;
//   ao        — the graph's Occlusion pin; it attenuates the ambient only, which is what makes it
//               ambient occlusion rather than a second albedo.
//
// The ORDER of assembly (ambient + occluded sun + punctual lights) is additive light transport and
// is the same order StaticMeshPBR and the deferred composite assemble in. Emission is NOT added here:
// the graph adds it at the output, unlit, exactly as it does in the unlit branch.
vec3 ShadeGraphSurface(vec3 worldPos, vec3 N, vec3 view, vec3 albedo, float metalness, float roughness,
                       float ao)
{
	metalness = clamp(metalness, 0.0, 1.0);
	roughness = clamp(roughness, 0.04, 1.0);
	ao        = clamp(ao, 0.0, 1.0);

	vec3 F0 = mix(GRAPH_FDIELECTRIC, albedo, metalness);

	// The ambient: the baked environment through the split-sum model, not a constant.
	vec3 ibl     = AmbientIBL(view, N, F0, metalness, roughness, albedo);
	vec3 ambient = ComposeAmbient(ibl, albedo, ao, vec3(0.0)); // no indirect gather on this path

	// The sun, occluded by the cloud layer. Only the DIRECTIONAL term is occluded — the ambient is
	// the whole sky dome and a cloud deck occludes it with a different geometry (see
	// Common/CloudShadowReceiver.glslh).
	vec3 sun = vec3(0.0);
	for (uint i = 0; i < lightsMetadata.DirectionLightCount; i++)
	{
		vec3 radiance = directionLights.directionLights.ColorIntensity.rgb
		              * directionLights.directionLights.ColorIntensity.a;
		sun += EvaluateDirectionalLight(directionLights.directionLights.Direction.xyz, radiance, view, N,
		                                F0, metalness, roughness, albedo);
	}
	sun *= CloudShadowFactor(worldPos);

	vec3 punctual = vec3(0.0);
	for (uint i = 0; i < lightsMetadata.PointLightCount; i++)
		punctual += CalculatePointLight(pointLights[i], worldPos, view, N, F0, metalness, roughness, albedo);
	for (uint i = 0; i < lightsMetadata.SpotLightCount; i++)
		punctual += CalculateSpotLight(spotLights[i], worldPos, view, N, F0, metalness, roughness, albedo);

	return ambient + sun + punctual;
}

#endif // GRAPH_SURFACE_LIGHTING_GLSLH
