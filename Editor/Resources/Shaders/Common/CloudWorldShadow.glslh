// CLOUD SHADOWS ON THE WORLD — the encoding a receiver that is NOT a cloud reads.
//
// Compiled as GLSL by the pass that writes it (Programs/Clouds/CloudWorldShadowMap.shader) and by every
// consumer that shades an opaque surface under the sun (Deferred/DeferredLighting, PBR/StaticMeshPBR and
// its two siblings, Terrain/Terrain, Grass/Grass), and as C++ by
// Desert/Tests/Engine/CloudMath/CloudGeometryReference.hpp. The restricted GLSL/C++ dialect at the top of
// Common/CloudGeometry.glslh applies unchanged.
//
// Requires, from the including shader: nothing. Common/CloudShadowProjection.glslh comes with it, and
// that header has no dependencies either — a lit surface must not have to include the raymarch to know
// whether a cloud is standing between it and the sun.
//
// ---- WHY A SECOND ENCODING AND NOT THE FOUR-SLICE MAP ----------------------------------------------
//
// Common/CloudShadow.glslh's map answers ONE question: "for a sample INSIDE layer L at height fraction h,
// how much of layer L's own mass lies above it". Every part of that is wrong for the ground:
//
//   * it is PER LAYER — one slice per shell, each with its own extent — and the ground is shadowed by
//     every deck in the sky at once, not by one of them;
//   * it is indexed by a height fraction INSIDE a shell, and a receiver below the layer has none;
//   * it stores density-length before ExtinctionScale, which the march multiplies in because
//     ExtinctionScale is a per-layer slider; a receiver has no layer to take it from.
//
// So this is the encoding UE ships instead (VolumetricCloudCommon.ush): three numbers per texel that
// describe the column ANALYTICALLY, and from which a receiver at ANY depth along the sun ray answers its
// own transmittance in one fetch and four instructions:
//
//   r  FrontDepthKm         where along the sun ray this column FIRST met cloud
//   g  MeanExtinctionPerKm  the column's optical depth spread evenly over the stretch that had cloud in it
//   b  MaxOpticalDepth      the whole column's optical depth — the cap, so a receiver below the deck gets
//                           the deck's real opacity and not an extrapolation off the end of the medium
//
// One 2D texture therefore shadows any point in 3D: ground, mid-air, a mesh halfway up a mountain. The
// four-slice map is UNTOUCHED and still serves the march — the teamlead's decision (research §5 Q3) is
// two encodings and no re-calibration of the cloud lighting that six merges just settled.
//
// ---- THE EMPTY COLUMN ------------------------------------------------------------------------------
//
// A texel whose sun ray met no cloud stores (0,0,0). The read-out below then computes an optical depth of
// exactly zero and a transmittance of exactly one, with no flag channel and no branch — which is what
// makes "the feature costs nothing where there are no clouds" true by arithmetic rather than by care.

#ifndef CLOUD_WORLD_SHADOW_GLSLH
#define CLOUD_WORLD_SHADOW_GLSLH

#include <Common/CloudShadowProjection.glslh>

// One world unit is one centimetre, so a kilometre is 100 000 of them. Spelled here rather than taken
// from Common/CloudGeometry.glslh's CLOUD_WORLD_UNITS_PER_KM because this header is deliberately
// dependency-free; the CloudMath suite pins the two against each other so they cannot drift.
const float CLOUD_WORLD_SHADOW_UNITS_PER_KM = 100000.0f;

// The column's optical depth ABOVE a receiver at @p depthKm, from the triple this texel stores.
//
// `max(0, depth - front)` is what makes a receiver ABOVE the cloud — a mountain top poking through the
// deck, an aircraft over it — unshadowed rather than shadowed by cloud that is beneath it. The clamp to
// the stored maximum is what stops the linear extrapolation running past the bottom of the medium: below
// the deck there is no more cloud to add, and without the cap a receiver a kilometre under a thin sheet
// would be blacker than one right beneath it.
float CloudWorldShadowOpticalDepth(vec3 encoded, float depthKm)
{
    float frontKm  = encoded.x;
    float meanExt  = encoded.y;
    float maxDepth = encoded.z;

    float through = max(depthKm - frontKm, 0.0f);
    return min(meanExt * through, maxDepth);
}

// The sun's transmittance through the cloud deck at a world point, in [0,1]. 1 = full sun.
//
// @p encoded  the RGB this point's texel stores.
// @p worldPos the receiver, world units.
// @p centre   the world point the map was built around, world units (the camera the map was traced from).
// @p sunDir   TOWARD the sun, normalized — the same vector the map was traced along.
// @p uv       where @p worldPos landed, from CloudShadowUv. Passed in rather than recomputed so the
//             caller can fetch the texture and test the bounds with ONE projection, not two.
//
// EDGE. The map is centred on the camera and covers a finite square (Cloud Shadow Extent, 30 km by
// default). Outside it there is no answer, and the honest one is "no shadow" — but a hard switch to full
// sun at the boundary would draw a straight bright line across the ground along nothing at all. So the
// answer is faded toward 1 across the outermost tenth of the map by the same CloudShadowEdgeFade the
// march uses, and CloudShadowEdgeFade reaches exactly 0 at the border, so the two halves of this
// expression meet continuously. Ground beyond the map's reach is lit, and the transition is a gradient.
float CloudWorldShadowTransmittance(vec3 encoded, vec3 worldPos, vec3 centre, vec3 sunDir, vec2 uv)
{
    if (!CloudShadowInside(uv))
        return 1.0f;

    float depthKm =
         CloudShadowDepthAlongSun(worldPos, centre, sunDir) * (1.0f / CLOUD_WORLD_SHADOW_UNITS_PER_KM);

    float transmittance = exp(-CloudWorldShadowOpticalDepth(encoded, depthKm));
    return mix(1.0f, transmittance, CloudShadowEdgeFade(uv));
}

// The multiplier a receiver applies to the DIRECTIONAL light's contribution, UE's
// `lerp(1, T, CloudShadowOnSurfaceStrength)` (DeferredLightPixelShaders.usf:198-204).
//
// @p strength 0 = the feature is off for this light and the result is exactly 1, bit for bit, which is
//             what lets the whole thing default to OFF with no second code path to test.
float CloudWorldShadowFactor(vec3 encoded, vec3 worldPos, vec3 centre, vec3 sunDir, vec2 uv, float strength)
{
    if (strength <= 0.0f)
        return 1.0f;

    float transmittance = CloudWorldShadowTransmittance(encoded, worldPos, centre, sunDir, uv);
    return mix(1.0f, transmittance, clamp(strength, 0.0f, 1.0f));
}

#endif // CLOUD_WORLD_SHADOW_GLSLH
