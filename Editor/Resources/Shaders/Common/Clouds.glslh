#ifndef CLOUDS_GLSLH
#define CLOUDS_GLSLH

// e2gamedev-style PROCEDURAL cloud layer (no volumetric raymarch, no textures): a flat cloud "ceiling"
// painted in the sky fragment shader. The view direction is projected onto a flat plane (dir.xz / dir.y),
// which naturally STRETCHES toward the horizon; fBm noise gives the shape/opacity (coverage threshold),
// a normal is derived from the noise gradient for "lit-from-below" scattering, and the colour follows the
// day / sunset / night state like the sky. Composited over the sky by opacity. Visual only (not baked).

// 2D SIMPLEX noise (Ashima Arts / Stefan Gustavson). Uses a TRIANGULAR lattice, so it has NO axis-aligned
// square grid — unlike value/Perlin noise, whose square lattice shows through in low-contrast regions (the
// "square gaps between clouds"). Returns ~[-1,1].
vec3 cl_mod289( vec3 x ) { return x - floor( x * ( 1.0 / 289.0 ) ) * 289.0; }
vec2 cl_mod289( vec2 x ) { return x - floor( x * ( 1.0 / 289.0 ) ) * 289.0; }
vec3 cl_permute( vec3 x ) { return cl_mod289( ( ( x * 34.0 ) + 1.0 ) * x ); }

float cl_snoise( vec2 v )
{
    const vec4 C = vec4( 0.211324865405187, 0.366025403784439, -0.577350269189626, 0.024390243902439 );
    vec2 i  = floor( v + dot( v, C.yy ) );
    vec2 x0 = v - i + dot( i, C.xx );
    vec2 i1 = ( x0.x > x0.y ) ? vec2( 1.0, 0.0 ) : vec2( 0.0, 1.0 );
    vec4 x12 = x0.xyxy + C.xxzz;
    x12.xy -= i1;
    i        = cl_mod289( i );
    vec3 p   = cl_permute( cl_permute( i.y + vec3( 0.0, i1.y, 1.0 ) ) + i.x + vec3( 0.0, i1.x, 1.0 ) );
    vec3 m   = max( 0.5 - vec3( dot( x0, x0 ), dot( x12.xy, x12.xy ), dot( x12.zw, x12.zw ) ), 0.0 );
    m        = m * m;
    m        = m * m;
    vec3 x   = 2.0 * fract( p * C.www ) - 1.0;
    vec3 h   = abs( x ) - 0.5;
    vec3 ox  = floor( x + 0.5 );
    vec3 a0  = x - ox;
    m *= 1.79284291400159 - 0.85373472095314 * ( a0 * a0 + h * h );
    vec3 g;
    g.x  = a0.x * x0.x + h.x * x0.y;
    g.yz = a0.yz * x12.xz + h.yz * x12.yw;
    return 130.0 * dot( m, g );
}

float cl_fbm2( vec2 p )
{
    float a = 0.5;
    float s = 0.0;
    const mat2 rot = mat2( 0.8, -0.6, 0.6, 0.8 );
    for ( int i = 0; i < 6; ++i )
    {
        s += a * ( cl_snoise( p ) * 0.5 + 0.5 );
        p = rot * p * 2.02;
        a *= 0.5;
    }
    return s;
}

// skyColor = the sky behind the clouds; dir = normalized view ray; sunDir = toward sun.
// coverage 0..1 (more = cloudier), density = opacity mult, tiling = cloud scale, brightness = cloud albedo.
vec3 RenderClouds( vec3 skyColor, vec3 dir, vec3 sunDir, float sunI, float coverage, float density,
                   float tiling, float brightness, float time, float windSpeed )
{
    if ( dir.y <= 0.03 )
        return skyColor; // below the horizon: no clouds

    // Flat-ceiling projection (stretches toward the horizon), tiled + wind drift.
    vec2 uv = ( dir.xz / dir.y ) * ( 0.15 * max( tiling, 0.01 ) );
    uv += vec2( time * windSpeed * 0.010, time * windSpeed * 0.006 );

    // Domain warp for organic billows (moderate — a too-strong warp FOLDS the field and creates sharp creases
    // at the seams between blobs).
    vec2 w1 = vec2( cl_fbm2( uv * 0.5 + 1.7 ), cl_fbm2( uv * 0.5 + 8.3 ) );
    uv += ( w1 - 0.5 ) * 1.3;

    // Coverage formula (same as classic volumetric clouds): density = shape - (1 - coverage), then a SOFT wide
    // fade-in. Multi-scale erosion frays the EDGES (wispy/fractal) so blob seams don't pinch into hard angular
    // notches (clean iso-contours of a single fBm are what made the "stupid angles").
    float cov   = clamp( coverage, 0.0, 1.0 );
    float shape = cl_fbm2( uv );
    shape      -= 0.22 * cl_fbm2( uv * 3.0 + 7.3 ) + 0.12 * cl_fbm2( uv * 7.0 + 2.1 ); // edge erosion
    float df    = shape - ( 1.0 - cov );
    float opacity = smoothstep( 0.0, 0.30, df ) * clamp( density, 0.0, 2.0 );

    // No clouds below the horizon; fade in above it (also kills the projection blow-up near dir.y=0).
    opacity *= smoothstep( 0.03, 0.30, dir.y );
    opacity = clamp( opacity, 0.0, 1.0 );
    if ( opacity < 0.001 )
        return skyColor;

    // Fake normal from the noise gradient -> "lit from below" term (dot(n, up)), like the reference.
    float e   = 0.06;
    float dx  = cl_fbm2( uv + vec2( e, 0.0 ) ) - cl_fbm2( uv - vec2( e, 0.0 ) );
    float dz  = cl_fbm2( uv + vec2( 0.0, e ) ) - cl_fbm2( uv - vec2( 0.0, e ) );
    vec3  n   = normalize( vec3( -dx, 0.6, -dz ) );
    float lit = 0.45 + 0.55 * clamp( n.y, 0.0, 1.0 );

    // Fake self-shadow: sample the cloud density a couple of steps TOWARD the sun (in the layer UV). Where
    // there's cloud between us and the sun, darken -> billowy depth/volume on the otherwise-flat layer.
    vec2  toSun = normalize( vec2( sunDir.x, sunDir.z ) + vec2( 1e-4 ) );
    float sh    = 0.5 * ( cl_fbm2( uv + toSun * 0.22 ) + cl_fbm2( uv + toSun * 0.50 ) );
    lit *= mix( 1.0, 0.5, smoothstep( 1.0 - cov - 0.10, 1.0 - cov + 0.20, sh ) );

    // Day / sunset / night colouring (mirrors the sky's day/night logic).
    float sunUp     = sunDir.y;
    float dayF      = smoothstep( -0.10, 0.20, sunUp );
    float sunset    = ( 1.0 - smoothstep( 0.0, 0.30, abs( sunUp ) ) ) * smoothstep( -0.25, 0.0, sunUp );
    vec3  dayCol    = vec3( 1.0, 1.0, 1.0 );
    vec3  nightCol  = vec3( 0.05, 0.07, 0.12 );
    vec3  sunsetTint = vec3( 1.0, 0.55, 0.35 );

    vec3 cloudCol = mix( nightCol, dayCol, dayF ) * brightness * lit;
    cloudCol      = mix( cloudCol, cloudCol * sunsetTint, sunset * 0.7 );
    // A little extra sun-facing brightening (silver lining toward the sun).
    cloudCol += vec3( 1.0, 0.95, 0.85 ) * pow( max( dot( dir, sunDir ), 0.0 ), 6.0 ) * 0.4 * dayF;

    return mix( skyColor, cloudCol, opacity );
}

#endif // CLOUDS_GLSLH
