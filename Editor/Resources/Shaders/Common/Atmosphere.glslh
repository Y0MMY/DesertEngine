// Shared procedural-sky model: single-scattering Rayleigh + Mie atmosphere, raymarched from a view
// ray and the sun direction (no HDR texture). Used by BOTH the screen sky pass
// (ProceduralSky.glsl.frag) and the IBL bake (Compute/BakeProceduralSky.glsl.comp) so the visible sky
// and the lighting it casts stay identical. Output is LINEAR HDR (tonemapped downstream).

#ifndef ATMOSPHERE_GLSLH
#define ATMOSPHERE_GLSLH

const float ATM_PI = 3.141592653589793;
const int   ATM_iSteps = 16; // primary (view) raymarch steps
const int   ATM_jSteps = 8;  // secondary (toward-sun) raymarch steps

// Ray vs. sphere (centred at origin). Returns near/far t; near>far means "miss".
vec2 atm_raySphere(vec3 r0, vec3 rd, float sr)
{
    float a = dot(rd, rd);
    float b = 2.0 * dot(rd, r0);
    float c = dot(r0, r0) - sr * sr;
    float d = b * b - 4.0 * a * c;
    if (d < 0.0) return vec2(1e5, -1e5);
    d = sqrt(d);
    return vec2((-b - d) / (2.0 * a), (-b + d) / (2.0 * a));
}

vec3 atm_Atmosphere(vec3 rayDir, vec3 rayOrigin, vec3 sunDir, float sunIntensity,
                    float rPlanet, float rAtmos, vec3 kRlh, float kMie, float shRlh, float shMie, float g)
{
    sunDir = normalize(sunDir);
    rayDir = normalize(rayDir);

    // March only the segment of the ray inside the atmosphere shell.
    vec2 p = atm_raySphere(rayOrigin, rayDir, rAtmos);
    if (p.x > p.y) return vec3(0.0);
    p.y = min(p.y, atm_raySphere(rayOrigin, rayDir, rPlanet).x);
    float iStepSize = (p.y - p.x) / float(ATM_iSteps);

    float iTime = 0.0;
    vec3  totalRlh = vec3(0.0);
    vec3  totalMie = vec3(0.0);
    float iOdRlh = 0.0;
    float iOdMie = 0.0;

    // Phase functions.
    float mu   = dot(rayDir, sunDir);
    float mumu = mu * mu;
    float gg   = g * g;
    float pRlh = 3.0 / (16.0 * ATM_PI) * (1.0 + mumu);
    float pMie = 3.0 / (8.0 * ATM_PI) * ((1.0 - gg) * (mumu + 1.0)) /
                 (pow(1.0 + gg - 2.0 * mu * g, 1.5) * (2.0 + gg));

    for (int i = 0; i < ATM_iSteps; i++)
    {
        vec3  iPos    = rayOrigin + rayDir * (iTime + iStepSize * 0.5);
        float iHeight = length(iPos) - rPlanet;

        float odStepRlh = exp(-iHeight / shRlh) * iStepSize;
        float odStepMie = exp(-iHeight / shMie) * iStepSize;
        iOdRlh += odStepRlh;
        iOdMie += odStepMie;

        // Optical depth from this sample toward the sun.
        float jStepSize = atm_raySphere(iPos, sunDir, rAtmos).y / float(ATM_jSteps);
        float jTime = 0.0;
        float jOdRlh = 0.0;
        float jOdMie = 0.0;
        for (int j = 0; j < ATM_jSteps; j++)
        {
            vec3  jPos    = iPos + sunDir * (jTime + jStepSize * 0.5);
            float jHeight = length(jPos) - rPlanet;
            jOdRlh += exp(-jHeight / shRlh) * jStepSize;
            jOdMie += exp(-jHeight / shMie) * jStepSize;
            jTime += jStepSize;
        }

        vec3 attn = exp(-(kMie * (iOdMie + jOdMie) + kRlh * (iOdRlh + jOdRlh)));
        totalRlh += odStepRlh * attn;
        totalMie += odStepMie * attn;
        iTime += iStepSize;
    }

    return sunIntensity * (pRlh * kRlh * totalRlh + pMie * kMie * totalMie);
}

// Full sky radiance along a world-space view direction: Earth-like atmosphere + crisp sun disk.
// sunDir = direction TOWARD the sun (normalized). Camera sits ~1m above the planet surface.
vec3 EvaluateSky(vec3 dir, vec3 sunDir, float sunIntensity, float sunDiskRadius)
{
    vec3 color = atm_Atmosphere(
        dir,
        vec3(0.0, 6372e3, 0.0),                  // ray origin (on the surface)
        sunDir,
        sunIntensity,                            // sun intensity
        6371e3,                                  // planet radius
        6471e3,                                  // atmosphere radius
        vec3(5.5e-6, 13.0e-6, 22.4e-6),          // Rayleigh scattering (RGB)
        21e-6,                                   // Mie scattering
        8e3,                                     // Rayleigh scale height
        1.2e3,                                   // Mie scale height
        0.758                                    // Mie directionality
    );

    // Crisp sun disk on top of the Mie glow.
    float sunRadius = max(sunDiskRadius, 0.0001);
    float cd        = dot(normalize(dir), normalize(sunDir));
    float disk      = smoothstep(cos(sunRadius * 2.0), cos(sunRadius), cd);
    color += disk * sunIntensity * 0.04;

    return color;
}

#endif // ATMOSPHERE_GLSLH
