// Tiling noise for the volumetric cloud volumes — the ONE source of truth for the maths.
//
// This file is compiled TWICE, from the same text:
//   * as GLSL, by the three CloudNoise* compute shaders that fill the volumes on the GPU;
//   * as C++, by Engine/Graphic/Clouds/CloudNoiseReference.hpp, which the CloudNoise unit tests drive.
// Vulkan is not available in the development environment, so the GPU result cannot be looked at. A CPU
// copy of the same formulas would only prove that the copy is self-consistent, and the two would drift
// the first time somebody tuned one of them. Sharing the text means a test that passes is a statement
// about the code the GPU runs, not about a paraphrase of it.
//
// The price is a restricted dialect: everything below is in the GLSL/C++ intersection.
//   * no swizzles (glm's are proxies), no `out` parameters, no arrays, no `inline`, no namespaces;
//   * float literals carry the `f` suffix (legal in GLSL since 1.20) so C++ does not silently widen;
//   * `uint` arithmetic wraps identically in both languages, which is what makes the hash reproducible;
//   * functions are defined before use, C-style, because GLSL has no forward declarations.
// The C++ side supplies vec2/vec3/uint/floor/fract/mix/... via glm, opens a namespace around the
// include and defines CLOUD_NOISE_CPU. Anything that is not in the intersection breaks one of the two
// builds immediately, which is the point.
//
// EVERY function here is periodic with period 1 in every coordinate. Seamless tiling is a requirement,
// not a nicety: the shape volume is tiled across tens of kilometres of sky, and a discontinuity at the
// tile boundary reads as a rectangular grid drawn over the cloudscape. Periodicity is achieved
// STRUCTURALLY — every lattice index is reduced modulo the period before it is hashed, so opposite faces
// hash the same cell by construction rather than by a blend that hides the seam.
//
// The formulas are the published ones (Perlin's improved gradient noise with the quintic fade; Worley's
// cellular noise over a 3x3x3 cell neighbourhood; the Perlin-Worley remap and the 0.625/0.25/0.125 FBM
// weights from the Guerrilla cloud talks; curl as the analytic curl of a vector potential). No third-party
// asset or source is copied — the reference project's textures are not redistributable (REF F.4).

#ifndef CLOUD_NOISE_GLSLH
#define CLOUD_NOISE_GLSLH

// ---- Hashing ---------------------------------------------------------------------------------------
//
// A 32-bit integer avalanche (the finalizer of MurmurHash3, Appleby 2011) applied to a mixed lattice
// index. Integer hashing rather than the widespread `fract(sin(dot(p, k)) * 43758.5453)`: the sine trick
// gives different results on different GPUs (and different results again on the CPU), and "the same seed
// gives the same volume" is the property this whole subsystem is tested on.

uint CloudHashMix(uint x)
{
    x ^= x >> 16;
    x *= 0x85EBCA6Bu;
    x ^= x >> 13;
    x *= 0xC2B2AE35u;
    x ^= x >> 16;
    return x;
}

// Hash of an integer lattice cell. The per-axis odd multipliers are large primes, so the three axes do
// not alias each other; the seed enters before the avalanche so two seeds decorrelate completely rather
// than shifting the same field.
uint CloudHashCell(uvec3 cell, uint seed)
{
    uint h = cell.x * 0x27D4EB2Du + cell.y * 0x9E3779B1u + cell.z * 0x85EBCA77u + seed * 0xC2B2AE3Du;
    return CloudHashMix(h);
}

// [0,1) from a hash. 24 bits, the exactly-representable range of float — using all 32 would round and
// could reach 1.0, and a feature point sitting exactly ON a cell boundary is a special case nobody wants.
float CloudHashUnit(uint h)
{
    return float(h >> 8) * (1.0f / 16777216.0f);
}

// ---- Helpers ---------------------------------------------------------------------------------------

// Euclidean remainder for a positive period, on a value that may be negative. GLSL's mod() and C++'s
// fmod() disagree on negatives, and `-1 mod 8` must be 7 here or the wrap at the tile's lower face is
// wrong (which is exactly a seam).
int CloudWrapInt(int v, int period)
{
    int m = v % period;
    if (m < 0)
        m += period;
    return m;
}

uvec3 CloudWrapCell(ivec3 cell, int period)
{
    return uvec3(uint(CloudWrapInt(cell.x, period)), uint(CloudWrapInt(cell.y, period)),
                 uint(CloudWrapInt(cell.z, period)));
}

// Perlin's quintic fade, 6t^5 - 15t^4 + 10t^3. Chosen over the cubic smoothstep because its SECOND
// derivative also vanishes at the lattice points: with the cubic, the curvature jumps at every cell
// boundary and the volume shows a faint lattice under lighting.
float CloudFade(float t)
{
    return t * t * t * (t * (t * 6.0f - 15.0f) + 10.0f);
}

// Rescales `v` from [lo,hi] into [0,1], clamped. The building block of the cloud-density remaps.
float CloudRemap01(float v, float lo, float hi)
{
    float d = hi - lo;
    // A zero-width source range is a division by zero on the GPU (inf, then NaN through the clamp), and
    // a NaN texel in a noise volume propagates through every sample that touches it.
    if (abs(d) < 1e-6f)
        return 0.0f;
    return clamp((v - lo) / d, 0.0f, 1.0f);
}

// ---- Perlin gradient noise, periodic ---------------------------------------------------------------

// One of 12 gradients pointing at the midpoints of a cube's edges (Perlin's improved-noise set). A
// fixed, evenly distributed set beats a random unit vector: it removes the directional clumping that
// makes plain random gradients look streaky, and it costs a table lookup written as arithmetic.
vec3 CloudGradient(uint h)
{
    uint  i  = h % 12u;
    float s0 = ((i & 1u) != 0u) ? -1.0f : 1.0f;
    float s1 = ((i & 2u) != 0u) ? -1.0f : 1.0f;
    // The 12 edge midpoints, spelled out rather than tabulated: GLSL and C++ do not share array
    // initializer syntax, and this file has to compile as both.
    if (i < 4u)
        return vec3(s0, s1, 0.0f);
    if (i < 8u)
        return vec3(s0, 0.0f, s1);
    return vec3(0.0f, s0, s1);
}

// Periodic Perlin noise. `p` is in tile space (period 1); `period` is the lattice resolution, so the
// lattice index wraps at `period` and the field repeats exactly every unit of p. Returns [-1,1]-ish.
float CloudPerlin(vec3 p, int period, uint seed)
{
    vec3  scaled = p * float(period);
    vec3  base   = floor(scaled);
    vec3  f      = scaled - base;
    ivec3 cell   = ivec3(int(base.x), int(base.y), int(base.z));

    float u = CloudFade(f.x);
    float v = CloudFade(f.y);
    float w = CloudFade(f.z);

    float acc = 0.0f;
    for (int dz = 0; dz < 2; ++dz)
    {
        for (int dy = 0; dy < 2; ++dy)
        {
            for (int dx = 0; dx < 2; ++dx)
            {
                uvec3 c = CloudWrapCell(ivec3(cell.x + dx, cell.y + dy, cell.z + dz), period);
                vec3  g = CloudGradient(CloudHashCell(c, seed));
                vec3  d = vec3(f.x - float(dx), f.y - float(dy), f.z - float(dz));
                float n = dot(g, d);

                float wx = (dx == 0) ? (1.0f - u) : u;
                float wy = (dy == 0) ? (1.0f - v) : v;
                float wz = (dz == 0) ? (1.0f - w) : w;
                acc += n * wx * wy * wz;
            }
        }
    }
    return acc;
}

// ---- Worley (cellular) noise, periodic -------------------------------------------------------------

// Inverted Worley: 1 at a feature point, falling to 0 between them — the "puffy blob" look clouds are
// built from. `period` is the number of cells per tile edge; wrapping the neighbour index makes it
// seamless. The 3x3x3 neighbourhood is enough because every feature point stays inside its own cell.
float CloudWorley(vec3 p, int period, uint seed)
{
    vec3  scaled = p * float(period);
    vec3  base   = floor(scaled);
    vec3  f      = scaled - base;
    ivec3 cell   = ivec3(int(base.x), int(base.y), int(base.z));

    float minDistSq = 3.0f; // (sqrt(3))^2 — the largest distance reachable inside the neighbourhood
    for (int dz = -1; dz <= 1; ++dz)
    {
        for (int dy = -1; dy <= 1; ++dy)
        {
            for (int dx = -1; dx <= 1; ++dx)
            {
                uvec3 c = CloudWrapCell(ivec3(cell.x + dx, cell.y + dy, cell.z + dz), period);
                uint  h = CloudHashCell(c, seed);
                // Three decorrelated coordinates from one hash: re-avalanche between axes rather than
                // slicing one 32-bit word, so the point positions do not lie on a lattice of their own.
                float px = CloudHashUnit(h);
                h        = CloudHashMix(h);
                float py = CloudHashUnit(h);
                h        = CloudHashMix(h);
                float pz = CloudHashUnit(h);

                vec3  point = vec3(float(dx) + px, float(dy) + py, float(dz) + pz);
                vec3  diff  = vec3(point.x - f.x, point.y - f.y, point.z - f.z);
                float dsq   = dot(diff, diff);
                minDistSq   = min(minDistSq, dsq);
            }
        }
    }
    return 1.0f - clamp(sqrt(minDistSq), 0.0f, 1.0f);
}

// ---- FBM ------------------------------------------------------------------------------------------
//
// Three octaves at 0.625 / 0.25 / 0.125 — the weights the Guerrilla cloud talks use, and they sum to 1
// so the result needs no renormalisation. Each octave doubles the cell count, which keeps the period an
// integer multiple of the base period and therefore keeps the sum seamless.

float CloudWorleyFbm(vec3 p, int period, uint seed)
{
    return CloudWorley(p, period, seed) * 0.625f + CloudWorley(p, period * 2, seed + 1u) * 0.25f +
           CloudWorley(p, period * 4, seed + 2u) * 0.125f;
}

// Perlin FBM mapped to [0,1]. Amplitudes halve while the period doubles, the classic 1/f spectrum; the
// 0.5 offset and 0.5 gain fold the signed gradient noise into the unit interval before it meets Worley.
float CloudPerlinFbm01(vec3 p, int period, uint seed)
{
    float n = CloudPerlin(p, period, seed) * 0.5f + CloudPerlin(p, period * 2, seed + 1u) * 0.25f +
              CloudPerlin(p, period * 4, seed + 2u) * 0.125f + CloudPerlin(p, period * 8, seed + 3u) * 0.0625f;
    // The weights sum to 0.9375 and gradient noise reaches about +/-0.7 of its nominal range, so the
    // constant below is a fixed normalisation, not a tuned fudge: it maps the theoretical extremes into
    // [0,1] and the clamp catches the rare sample that overshoots.
    return clamp(n * 1.5f + 0.5f, 0.0f, 1.0f);
}

// Perlin-Worley: Perlin noise whose LOW end is pushed up by the Worley field, so the result keeps
// Perlin's connected, billowy structure while gaining Worley's rounded lobes. This is the published
// remap `Remap(perlin, worleyFbm - 1, 1, 0, 1)`; it is the single most recognisable ingredient of the
// cloud base shape.
float CloudPerlinWorley(vec3 p, int period, uint seed)
{
    float perlin = CloudPerlinFbm01(p, period, seed);
    float worley = CloudWorleyFbm(p, period, seed + 101u);
    return CloudRemap01(perlin, worley - 1.0f, 1.0f);
}

// ---- Alligator (cellular) noise, periodic ----------------------------------------------------------
//
// The Nubis3 detail bases (deck pp.93-94): billows moved from Worley to ALLIGATOR, wisps from
// Perlin-Worley to CURLY-ALLIGATOR. Alligator (SideFX's name; the HDK ships the reference
// implementation) is a cellular noise where every feature point radiates a randomly-weighted falloff and
// the value is the LARGEST contribution MINUS THE SECOND largest: bright cell interiors, and a sharp
// dark crease exactly where two cells' influence balances — the crevice network between cauliflower
// lobes, which is precisely what a plain Worley blob field does not have. The formulas here are built
// from the published description on the same lattice machinery as everything above; no third-party
// source is copied.

float CloudAlligator(vec3 p, int period, uint seed)
{
    vec3  scaled = p * float(period);
    vec3  base   = floor(scaled);
    vec3  f      = scaled - base;
    ivec3 cell   = ivec3(int(base.x), int(base.y), int(base.z));

    float best   = 0.0f;
    float second = 0.0f;
    for (int dz = -1; dz <= 1; ++dz)
    {
        for (int dy = -1; dy <= 1; ++dy)
        {
            for (int dx = -1; dx <= 1; ++dx)
            {
                uvec3 c = CloudWrapCell(ivec3(cell.x + dx, cell.y + dy, cell.z + dz), period);
                uint  h = CloudHashCell(c, seed);
                float px = CloudHashUnit(h);
                h        = CloudHashMix(h);
                float py = CloudHashUnit(h);
                h        = CloudHashMix(h);
                float pz = CloudHashUnit(h);
                h        = CloudHashMix(h);
                // Amplitude in [0.5, 1]: fully random amplitudes let a weak point's cell collapse to
                // nothing and the field goes patchy; half-range keeps every cell present but varied.
                float amp = 0.5f + 0.5f * CloudHashUnit(h);

                vec3  point = vec3(float(dx) + px, float(dy) + py, float(dz) + pz);
                vec3  diff  = vec3(point.x - f.x, point.y - f.y, point.z - f.z);
                float d     = sqrt(dot(diff, diff));

                // Quadratic falloff over one cell width: C1 at its zero, so the creases where two
                // contributions meet are lines, not plateaus.
                float fall = max(1.0f - d, 0.0f);
                float contribution = amp * fall * fall;

                if (contribution > best)
                {
                    second = best;
                    best   = contribution;
                }
                else if (contribution > second)
                {
                    second = contribution;
                }
            }
        }
    }
    return clamp(best - second, 0.0f, 1.0f);
}

// Curly-Alligator: alligator evaluated at a curl-style warped position. The warp is a periodic Perlin
// vector field, so the composition tiles for the same structural reason everything else here does
// (both factors have period 1 in p). The warp is what stretches the cells into the feathery swirled
// filaments the deck's wispy channels show (p.205: "feathery swirled filaments").
float CloudCurlyAlligator(vec3 p, int period, uint seed)
{
    vec3 warp = vec3(CloudPerlin(p, 4, seed + 9001u), CloudPerlin(p, 4, seed + 9103u),
                     CloudPerlin(p, 4, seed + 9203u));
    return CloudAlligator(p + warp * 0.45f, period, seed);
}

// FBM stacks with the same 0.625/0.25/0.125 weights as the Worley FBM, for the same seamlessness reason:
// each octave doubles the cell count, an integer multiple of the base period.
float CloudAlligatorFbm(vec3 p, int period, uint seed)
{
    return CloudAlligator(p, period, seed) * 0.625f + CloudAlligator(p, period * 2, seed + 1u) * 0.25f +
           CloudAlligator(p, period * 4, seed + 2u) * 0.125f;
}

float CloudCurlyAlligatorFbm(vec3 p, int period, uint seed)
{
    return CloudCurlyAlligator(p, period, seed) * 0.625f +
           CloudCurlyAlligator(p, period * 2, seed + 1u) * 0.25f +
           CloudCurlyAlligator(p, period * 4, seed + 2u) * 0.125f;
}

// ---- The three volumes' texel functions ------------------------------------------------------------
//
// Each returns the finished RGBA texel for a normalized coordinate in [0,1)^n, so the shader is a
// coordinate computation plus one call, and the test drives exactly the same function.

// Shape volume, 128^3. R = Perlin-Worley base shape; G/B/A = Worley FBM at rising frequencies, the
// erosion octaves the raymarch subtracts from the base (REF F.2, `lowResCloudShape`).
//
// THE BASE PERIOD IS WHAT SETS CLOUD SIZE, and it used to be 4. Over the authored 35 km tile that made one
// base cell 8.75 km across — the size of a mountain range, not of a cumulus, which is 0.5 to 2 km. Worse,
// the layer is 3.5 km thick, so a cell did not complete half a period vertically and the base shape was a
// two-dimensional pattern extruded upward: every cloud got the same flat top and flat bottom, and looking
// straight up at a Coverage of 0.5 showed EMPTY SKY, because the whole visible zenith fell inside one cell.
//
// Twelve puts a cell at 2.9 km. The alternative — shrinking the tile — was tried and is worse: at 3 km the
// field repeats forty times between the camera and the horizon and the cloudscape reads as a radial moire
// fan. Raising the frequency inside the tile buys cloud-sized features while the tile stays large enough
// that it repeats four times over 138 km, which the weather map's own variation then hides.
//
// The erosion octaves rise with it, but not proportionally: 128 texels over 32 cells is four texels per
// cell, and past that a Worley lattice is noise rather than structure (the same limit the detail volume's
// comment below describes).
vec4 CloudShapeTexel(vec3 p, uint seed)
{
    float r = CloudPerlinWorley(p, 12, seed);
    float g = CloudWorleyFbm(p, 18, seed + 211u);
    float b = CloudWorleyFbm(p, 24, seed + 307u);
    float a = CloudWorleyFbm(p, 32, seed + 401u);
    return vec4(r, g, b, a);
}

// Detail volume, 128^3 — the Nubis3 spec exactly (deck p.94: "4 Channel, 128 x 128 x 128 Voxels"), with
// the deck's channel semantics: R/G = low/high-frequency CURLY-ALLIGATOR (the wispy erosion pair),
// B/A = low/high-frequency ALLIGATOR (the billowy pair). CLD-110.
//
// It was 32^3 of Worley FBM, and that is most of what "putty clouds" was made of: at the authored 4 km
// tile one texel was 125 metres, so the finest carving the erosion could do was a football field, and a
// Worley blob field erodes round dents — no crevice network, no filaments. 128^3 puts a texel at ~16 m
// at the v3 default 2 km tile, and the top FBM octave (period 8 x 4 = 32 cells) keeps the four-texels-
// per-cell floor the shape volume's comment derives.
vec4 CloudDetailTexel(vec3 p, uint seed)
{
    float r = CloudCurlyAlligatorFbm(p, 4, seed + 503u);
    float g = CloudCurlyAlligatorFbm(p, 8, seed + 601u);
    float b = CloudAlligatorFbm(p, 4, seed + 701u);
    float a = CloudAlligatorFbm(p, 8, seed + 809u);
    return vec4(r, g, b, a);
}

// ---- Curl noise, 2D --------------------------------------------------------------------------------

// A periodic scalar potential over the unit square, built from the 3D Perlin FBM on the z = const plane.
// Reusing the 3D noise keeps one lattice implementation instead of a second 2D one to keep periodic.
float CloudPotential(vec2 uv, uint seed)
{
    return CloudPerlinFbm01(vec3(uv.x, uv.y, 0.5f), 4, seed) * 2.0f - 1.0f;
}

// Curl of a vector potential Psi(x,y) = (p0, p1, p2) that varies only in x and y:
//     curl(Psi) = ( dp2/dy , -dp2/dx , dp1/dx - dp0/dy )
// Every component is a genuine curl component, so the field is divergence-free by construction — which
// is the whole reason curl noise is used to warp a density lookup: a divergence-free warp swirls the
// detail without creating or destroying it. Central differences on a field that is exactly periodic are
// themselves exactly periodic, so the curl texture tiles for the same structural reason the potential
// does; there is no boundary special case.
vec3 CloudCurl(vec2 uv, uint seed)
{
    // One texel of a 128-wide map. Small enough to be a derivative, large enough that the difference is
    // not eaten by float cancellation.
    float e  = 1.0f / 128.0f;
    float i2 = 1.0f / (2.0f * e);

    float p0yp = CloudPotential(vec2(uv.x, uv.y + e), seed);
    float p0yn = CloudPotential(vec2(uv.x, uv.y - e), seed);

    float p1xp = CloudPotential(vec2(uv.x + e, uv.y), seed + 1013u);
    float p1xn = CloudPotential(vec2(uv.x - e, uv.y), seed + 1013u);

    float p2xp = CloudPotential(vec2(uv.x + e, uv.y), seed + 2027u);
    float p2xn = CloudPotential(vec2(uv.x - e, uv.y), seed + 2027u);
    float p2yp = CloudPotential(vec2(uv.x, uv.y + e), seed + 2027u);
    float p2yn = CloudPotential(vec2(uv.x, uv.y - e), seed + 2027u);

    float dp2dy = (p2yp - p2yn) * i2;
    float dp2dx = (p2xp - p2xn) * i2;
    float dp1dx = (p1xp - p1xn) * i2;
    float dp0dy = (p0yp - p0yn) * i2;

    return vec3(dp2dy, -dp2dx, dp1dx - dp0dy);
}

// Curl map texel. The curl is a signed vector; it is stored in an unsigned RGBA8 volume, so it is scaled
// by a FIXED constant and folded into [0,1]. The constant is part of the encoding, not a tuning knob:
// the consumer decodes with the matching CLOUD_CURL_DECODE below, and the clamp means a rare large
// gradient saturates instead of wrapping around to the opposite direction.
const float CLOUD_CURL_ENCODE_SCALE = 0.25f;
const float CLOUD_CURL_DECODE_SCALE = 4.0f; // 1 / CLOUD_CURL_ENCODE_SCALE

// Half the decode scale IS the largest magnitude a decoded component can have: the byte holds
// c * ENCODE + 0.5 clamped into [0,1], so c is recoverable over [-2, 2] and saturates outside it.
// Named because the warp below has to divide by it to mean anything in world units.
const float CLOUD_CURL_DECODE_MAX = 2.0f; // CLOUD_CURL_DECODE_SCALE * 0.5

// The FINEST lattice in the curl field, and therefore the length over which the curl vector itself
// changes direction. CloudPotential is CloudPerlinFbm01(p, 4, ...), whose four octaves run at periods
// 4, 8, 16 and 32 — and because a curl is a GRADIENT, every octave contributes equally to it (weight
// 0.5^i times period 4*2^i is the same product for all four), so the field's correlation length is set
// by the finest of them: CurlTileSize / 32.
//
// This number is what makes the warp a warp. A displacement field folds the domain it warps as soon as
// |grad D| reaches 1, and grad D is the displacement divided by the length over which the curl turns —
// so a warp longer than CurlTileSize / 32 does not swirl the detail, it shreds it. See the warp site in
// Common/CloudDensityProcedural.glslh for what that looked like on screen.
const float CLOUD_CURL_FINEST_PERIOD = 32.0f;

// The finest structure the RIDGED high-frequency band can carry, as cells across one tile of the volume
// it is sampled from. CloudDetailTexel builds its G and A channels — the two the band folds — from a
// three-octave FBM starting at period 8, so their finest lattice is 8 * 4 = 32 cells per tile, and the
// band's `1 - |(|2x-1|*2-1)|^p` fold puts a second crease inside every one of them: 64.
//
// This is the number that turns "the band's features should be F across" into a tile size, and it is
// what makes the band's frequency a stated quantity rather than whatever the detail tile happened to be.
const float CLOUD_DETAIL_RIDGED_FINEST_PER_TILE = 64.0f;

// ---- What the EROSION's own frequencies are, so the march can say whether it resolves them -----------
//
// The two numbers below are what let the density seam gate the detail composite by the sampling rate
// instead of by an authored distance — the same argument CloudNyquistWeight makes for the ridged band,
// applied to the erosion itself. They are properties of CloudDetailTexel above and change with it.
//
// THE FEATURE SIZE OF AN FBM is not the size of its finest octave: an octave four times finer carries an
// eighth of the amplitude and is a ripple on the shape, not the shape. The honest single number is the
// AMPLITUDE-WEIGHTED mean feature size. Every channel here is a three-octave stack at periods p, 2p, 4p
// with the weights 0.625 / 0.25 / 0.125 that CloudAlligatorFbm applies, so
//
//     F = SUM w_i * tile / (p * 2^i) = (tile / p) * (0.625 + 0.25/2 + 0.125/4) = (tile / p) * 25/32
//
// and the cells-per-tile that inverts it is 32p/25. The two channel PAIRS run at different p — R and B
// at 4, G and A at 8 (see CloudDetailTexel) — which is why there are two constants and not one: the
// coarse pair stays resolvable for twice the distance the fine pair does, and gating them together would
// throw away structure the march can still carry. Each pair fades on its own.
const float CLOUD_DETAIL_EROSION_LOW_PER_TILE  = 5.12f;  // R, B: 32 * 4 / 25
const float CLOUD_DETAIL_EROSION_HIGH_PER_TILE = 10.24f; // G, A: 32 * 8 / 25

// WHAT A SAMPLE PAST THAT LIMIT CARRIES INSTEAD: the volume's own mean.
//
// There is no mip chain on these volumes — Core::Formats::Image3DSpecification is single-level by design
// because the engine has no 3D mip generator — so a sample that cannot resolve the lattice cannot be
// handed a filtered one either. What it can be handed is the limit of that filtering, which is the mean
// of the channel over the whole volume; substituting it leaves the erosion's EXPECTED cut unchanged and
// removes only the instance nobody can reconstruct.
//
// One constant for all four channels because they are all the same construction at a different period,
// and an FBM's mean does not depend on its period: measured over the 128^3 grid the shader bakes, the
// four channels sit at 0.116 to 0.129 across three seeds, i.e. within +/-0.007 of the value below. The
// CloudNoise suite recomputes it from CloudDetailTexel and fails if the construction drifts away from it.
const float CLOUD_DETAIL_MEAN_LEVEL = 0.1225f;

// And its SPREAD, which is the other half of the same substitution.
//
// Handing a far sample the mean gets its expected THRESHOLD right and its expected DENSITY wrong, because
// the erosion cut is a hinge — max(d - t, 0) — and the mean of a hinge is not the hinge of the mean. What
// closes that gap is the standard deviation of the variation the sample no longer sees; the erosion cut
// (CloudErodeDensity) widens its knee by exactly this much and recovers the mean it would otherwise lose.
//
// Measured the same way and equally stable: 0.0805 to 0.0854 over the four channels and three seeds.
const float CLOUD_DETAIL_SD_LEVEL = 0.0827f;

// Alpha is 1: the engine has no two- or three-channel image format (Core::Formats::ImageFormat has
// RGBA8F as its only 8-bit colour format), so the fourth channel is paid for by the format and left at
// a documented constant rather than filled with a number nobody reads.
vec4 CloudCurlTexel(vec2 uv, uint seed)
{
    vec3 c = CloudCurl(uv, seed);
    return vec4(clamp(c.x * CLOUD_CURL_ENCODE_SCALE + 0.5f, 0.0f, 1.0f),
                clamp(c.y * CLOUD_CURL_ENCODE_SCALE + 0.5f, 0.0f, 1.0f),
                clamp(c.z * CLOUD_CURL_ENCODE_SCALE + 0.5f, 0.0f, 1.0f), 1.0f);
}

#endif // CLOUD_NOISE_GLSLH
