// The v1 density source: a PROCEDURAL cloudscape — weather map, height envelope, base shape volume,
// detail erosion. It is one of the two implementations of Common/CloudDensity.glslh's seam; the other is
// Common/CloudDensityVoxel.glslh, and Common/CloudDensityCompose.glslh is what gives the seam's three
// names to the UNION of the two (teamlead Q1). Nothing outside those three files reaches past this one.
//
// Its functions therefore carry the `Procedural` suffix: GLSL has no overloading on file scope and the
// seam names belong to the composer.
//
// WHAT THE VOXEL BRANCH SHARES WITH THIS FILE, and it is most of it: CloudDensityErode below is the whole
// detail composite — curl warp, detail fetch, wispy/billowy lerp, the near-field ridged band, the erosion
// remap, the density-scale sharpen, the distance softening, the near fade and the height bias. The design
// review's central finding (VOXEL_CLOUD_PATH.md §1.4) is that a baked volume substitutes exactly THREE
// inputs — profile, detail type, density scale — and reuses every line downstream. So those three are
// arguments and the rest is one function, called by both branches. Forking it would be how the two
// slowly stop looking like the same sky.
//
// Why procedural at all: the reference's density is a pair of 512x512x64 volumes baked from Guerrilla's
// internal Houdini tools, which we cannot ship (RESEARCH_REFERENCE J.1 risk 1). What replaces them is
// the older, better-documented Nubis1/2 construction — a coverage/type weather map, the vertical
// envelope, and detail erosion — reimplemented from the published formulas.
//
// Requires, in this order, from the including shader:
//   #include <Common/CloudNoise.glslh>     (the curl encoding constants)
//   #include <Common/CloudGeometry.glslh>  (CloudRemapRange)
//   #include <Common/CloudParams.glslh>    (the parameter block)

#ifndef CLOUD_DENSITY_PROCEDURAL_GLSLH
#define CLOUD_DENSITY_PROCEDURAL_GLSLH

#include <Common/CloudDensity.glslh>
#include <Common/CloudProfile.glslh>

layout(binding = 3) uniform sampler3D u_ShapeNoise;
layout(binding = 4) uniform sampler3D u_DetailNoise;
layout(binding = 5) uniform sampler2D u_CurlNoise;

// THE THREE PER-LAYER TABLES ARE VOLUMES, one slice per cloud layer (Graphic::kCloudMaxLayers deep). The
// noise volumes above are shared by every layer — they are a shape vocabulary, not weather — but the
// weather map, the per-cell height map and the authored type curves are all functions of a LAYER's own
// settings, so a deck and a sheet need their own.
//
// A volume and not two samplers: the engine refuses arrayed images by design, its own answer to "N of the
// same thing" is a tiled volume (Common/CloudDensityVoxel.glslh), and one sampler means one fetch instead
// of a per-pixel branch between two — see CloudLayerSliceW in Common/CloudGeometry.glslh.
layout(binding = 6) uniform sampler3D u_WeatherMap;
layout(binding = 10) uniform sampler3D u_ProfileMap;
layout(binding = 11) uniform sampler3D u_ProfileLut;

// ---- Sampling coordinates --------------------------------------------------------------------------

// Where on the weather map a world position lands. The map tiles across the sky at WeatherTileSize, and
// whole cloud SYSTEMS drift across it at WeatherScrollMultiplier — much slower than the clouds' own
// shape, which is what makes a sky read as weather rather than as a scrolling texture.
vec2 CloudWeatherUV(vec3 worldPos)
{
    vec3  wind   = CloudWindVelocity();
    float t      = CloudTime();
    vec2  offset = vec2(wind.x, wind.z) * (t * u_WeatherScrollMultiplier);
    return (vec2(worldPos.x, worldPos.z) + offset) / u_WeatherTileSize;
}

vec4 CloudSampleWeather(vec3 worldPos)
{
    vec2 uv = CloudWeatherUV(worldPos);
    return texture(u_WeatherMap, vec3(uv.x, uv.y, CloudActiveLayerSliceW()));
}

// The lean a sheared wind gives a cloud: a FIXED horizontal displacement proportional to height, in
// fractions of the layer's own thickness. Wind Height Shear = 0.3 leans the top of the layer three tenths
// of a layer-thickness downwind of its base, and it stays there.
//
// It used to multiply the SCROLL — `wind * t * (1 + shear * height)` — which made the displacement between
// base and top grow without bound with elapsed time. A minute into a scene the top and bottom of a layer
// were sampling the detail volume hundreds of metres apart, which drew the cloud out into a comb of
// vertical streaks; ten minutes in they were kilometres apart. A lean is a shape, not a rate.
vec3 CloudWindLean(vec3 wind, float heightFraction)
{
    vec2 horizontal = vec2(wind.x, wind.z);
    if (dot(horizontal, horizontal) < 1e-8f)
        return vec3(0.0f, 0.0f, 0.0f);

    vec2 dir = normalize(horizontal);
    float d  = u_WindHeightShear * clamp(heightFraction, 0.0f, 1.0f) * u_LayerThickness;
    return vec3(dir.x * d, 0.0f, dir.y * d);
}

// The shape lookup drifts with the wind and LEANS with height: the top of a layer sits downwind of its
// base, which tilts a cumulus over instead of sliding it sideways as a rigid block.
vec3 CloudShapeSamplePos(vec3 worldPos, float heightFraction)
{
    vec3  wind = CloudWindVelocity();
    float t    = CloudTime();
    return worldPos + wind * (t * u_ShapeScrollMultiplier) + CloudWindLean(wind, heightFraction);
}

// Detail drifts faster than shape (the classic "boiling" look) and also rises: convection carries the
// small structure upward through the layer while the layer as a whole moves downwind.
vec3 CloudDetailSamplePos(vec3 worldPos, float heightFraction)
{
    vec3  wind = CloudWindVelocity();
    float t    = CloudTime();
    return worldPos + wind * (t * u_DetailScrollMultiplier) + CloudWindLean(wind, heightFraction) +
           vec3(0.0f, t * u_WindUpliftSpeed, 0.0f);
}

// ---- The vertical envelope -------------------------------------------------------------------------

// The cloud's vertical profile at this place on the map, the deck's Vertical Profile Method (p. 19):
// an AUTHORED curve chosen by the cell's type, evaluated between the cell's OWN base and ceiling.
//
// What this replaced, and why. The old form blended three fixed trapezoids by the type:
//
//     mix( pow(baseIn_s, P1) * pow(topOut_s, P2), ... , t )
//
// Every one of those is a monotone rise times a monotone fall, and a blend of three of them is still
// bounded by the family. Dragging Cloud Type could move the four remap heights and nothing else, so the
// only thing an artist ever saw was the SAME cloud, taller — the exact complaint this replaces. The
// curves now come out of a table the CPU bakes from authored control values
// (Engine/Graphic/Clouds/CloudProfileCurves.hpp), so a step along the type axis can pinch a waist into
// a cloud, leave a stalk under a flaring head, or put a hard flat base under a lighter turret. Its
// three legacy rows ARE the three trapezoids, so nothing the old knob could express was lost.
//
// And the profile is sampled between a per-cell Min/Max Height rather than across the whole layer, so
// neighbouring cells sit in different vertical slabs: one cloud's base above its neighbour's top. That
// is the pp. 126/150 signature, and one global slab cannot produce it at any setting.
//
// @param heightFraction  0 at the bottom of the LAYER, 1 at its top.
// @param cloudType       the weather map's G channel.
// @param band            this cell's own [base, ceiling], from CloudProfileCellBand.
float CloudHeightGradient(float heightFraction, float cloudType, vec2 band)
{
    float cellHeight = CloudProfileCellHeight(heightFraction, band);
    if (cellHeight < 0.0f || cellHeight > 1.0f)
        return 0.0f;

    ivec3 lutExtent = textureSize(u_ProfileLut, 0);
    vec2  lutSize   = vec2(float(lutExtent.x), float(lutExtent.y));
    vec2  lutUv     = CloudProfileLutCoord(cellHeight, cloudType, lutSize);
    vec3  texel     = texture(u_ProfileLut, vec3(lutUv.x, lutUv.y, CloudActiveLayerSliceW())).rgb;
    return CloudProfileCompose(texel, u_BaseGradientPower, u_TopGradientPower);
}

// This cell's vertical band, from the profile map's two height channels and the authored amount. Same
// tiling and same scroll as the weather map — they describe the same cell, and a cell whose coverage
// and whose altitude came from two different places on the ground is two clouds, not one.
vec2 CloudCellBand(vec3 worldPos)
{
    vec2 uv  = CloudWeatherUV(worldPos);
    vec2 ndf = texture(u_ProfileMap, vec3(uv.x, uv.y, CloudActiveLayerSliceW())).rg;
    return CloudProfileCellBand(ndf.x, ndf.y, u_CloudHeightVariance);
}

// The anvil: near the top of the layer the coverage exponent is pulled below 1, which widens the cloud
// there instead of letting it taper — the cumulonimbus spreading out against the tropopause.
float CloudAnvilCoverage(float coverage, float heightFraction)
{
    float exponent = CloudRemapRange(heightFraction, 0.7f, 0.8f, 1.0f, mix(1.0f, 0.5f, clamp(u_AnvilBias, 0.0f, 1.0f)));
    return pow(clamp(coverage, 0.0f, 1.0f), exponent);
}

// ---- The functions the seam declares ---------------------------------------------------------------

// The rain-laden fraction at this place on the map, for the lighting's precipitation darkening. See the
// note in Common/CloudDensity.glslh for why this is a function of the seam and not a read in the loop.
float CloudPrecipitationAtProcedural(vec3 worldPos)
{
    return CloudSampleWeather(worldPos).b;
}

// Coarse tier and shadow ray: weather x envelope x base shape. One 2D fetch and one 3D fetch, no detail,
// no lighting. This is what makes the empty-space skip pay for itself — see CloudMarchAdvance.
// The body of CloudDensityCheap, given a weather sample the caller already has. Split out so that
// CloudDensitySample — which needs the same texel again for its density-scale channel — pays for one 2D
// fetch instead of two. The fetch is not free at the rate this runs: once per fine sample plus once per
// cone sample, so up to seven per shaded step.
float CloudDensityCheapFrom(vec4 weather, vec2 band, vec3 worldPos, float heightFraction)
{
    // The anvil spreads at the top of a CLOUD, not at the top of the layer. Read at layer height it
    // would never fire for a cell whose ceiling sits below 0.8 of the layer — most of them, once the
    // bands vary — and would fire mid-body for a cell whose base sits high. At Cloud Height Variance 0
    // the two heights are the same number, so this is not a change to any sky authored before bands.
    float cellHeight = clamp(CloudProfileCellHeight(heightFraction, band), 0.0f, 1.0f);

    float coverage = CloudAnvilCoverage(weather.r, cellHeight);
    if (coverage <= 0.0f)
        return 0.0f;

    float gradient = CloudHeightGradient(heightFraction, weather.g, band);
    if (gradient <= 0.0f)
        return 0.0f;

    // The deck's Vertical Profile Method, composed the way p.19 writes it:
    //
    //     dimensional_profile = vertical_profile * cloud_coverage;
    //
    // MULTIPLIED, not thresholded. The profile is deliberately SMOOTH (p.18 renders it bare: featureless
    // slabs) — the weather map owns where a cloud is and the envelope owns its silhouette, and ALL the
    // billow and wisp character comes from the detail erosion on top. This replaced the Schneider-lineage
    // construction that carved an isosurface out of 3D Perlin-Worley with a second Worley erosion: an
    // isosurface of low-frequency 3D noise has no reason to look like convection, and it didn't — every
    // cloud rendered as a melted amoeba whose shape traced the lattice, not the envelope.
    // The map's coverage channel arrives ALREADY cut and contrast-shaped by the Coverage sliders
    // (CloudWeather.shader:89-90) — applying them again here is how coverage became "a threshold, not a
    // sky fraction" (RESEARCH_REFERENCE §M.4).
    float dimensional = gradient * coverage;

    // The 3D base volume stays as a MODULATION of the body, not its source: a mild large-scale variation
    // that keeps two clouds at the same map coordinate from being the same cloud, exactly the role the
    // deck's per-voxel Density Scale channel plays for its baked NVDFs. Base Shape Remap Min sets where
    // the volume reads as empty; Shape Erosion Strength is how much of the modulation is let through.
    //
    // textureLod with an explicit 0 and not texture(): the march is a COMPUTE shader, where an implicit
    // level of detail is UNDEFINED — the same reason Programs/Clouds/CloudTemporalResolve.shader spells
    // its history fetch out. Every volume here has one level, so 0 is the only answer there has ever
    // been; this site was relying on the driver reaching it.
    vec4  shape = textureLod(u_ShapeNoise, CloudShapeSamplePos(worldPos, heightFraction) / u_ShapeTileSize,
                             0.0f);
    float body  = CloudRemapRange(shape.r, u_BaseShapeRemapMin, 1.0f, 0.0f, 1.0f);
    return clamp(dimensional * mix(1.0f, body, clamp(u_ShapeErosionStrength, 0.0f, 1.0f)), 0.0f, 1.0f);
}

float CloudDensityCheapProcedural(vec3 worldPos, float heightFraction)
{
    vec4 weather = CloudSampleWeather(worldPos);

    // Where there is no coverage there is no cloud, whatever the cell's band or its type says: the
    // envelope is MULTIPLIED by coverage. Returning here is exactly what CloudDensityCheapFrom's own
    // coverage test does one line later — the point of doing it before the call is the fetch it skips.
    // This tier runs once per coarse step and up to LightMarchSamples times per shaded step, and most of
    // those land in empty sky, so the profile map is only paid for where a cloud actually is.
    if (weather.r <= 0.0f)
        return 0.0f;

    return CloudDensityCheapFrom(weather, CloudCellBand(worldPos), worldPos, heightFraction);
}

// Where the detail composite LOOKS: the drifting, leaning sample position, swirled by the curl field.
//
// Its own function because it is the one part of the composite that costs a texture fetch without
// producing any density: past the erosion's sampling limit there is nothing to warp, so the caller skips
// this entirely rather than paying for a swirl it is about to replace with a mean.
//
// Curl warps the DETAIL lookup, not the shape: a divergence-free warp swirls small structure around
// without creating or destroying any of it, which is what gives an edge its turbulent look. The warp
// is strongest at the cloud base, where the shear against still air is.
//
// TWO THINGS WERE WRONG HERE, and together they were the vertical combing on every cloud edge that
// three passes over this renderer had described and none had located.
//
// THE AXES. CloudCurl builds its field over the map's own two axes, which are world X and world Z,
// and returns (dPsi/dv, -dPsi/du, vorticity): the first TWO components are the divergence-free
// in-plane field and the third is the vertical vorticity, which is a rotation RATE and not a
// displacement at all. This site fed the returned vector straight into a world (x, y, z) offset, so
// the second in-plane component displaced the lookup VERTICALLY and the vorticity displaced it in Z.
// A vertical offset that is a function of horizontal position alone shifts the whole detail column
// up or down together — the pattern stays coherent down a screen column while decorrelating across
// one, which is precisely a comb of vertical filaments.
//
// THE SCALE. The offset was `CurlStrength * DetailTileSize` — measured in DETAIL tiles, a quantity
// the warp has no relationship to. A displacement field folds the domain it warps once the
// displacement exceeds the length over which the displacement itself turns, and for this field that
// length is CurlTileSize / CLOUD_CURL_FINEST_PERIOD (see there). At the showcase's 9 km curl tile
// that is 280 m, while the old expression displaced by up to 0.35 * 4 km * 2 = 2.8 km: ten times
// past folding, so the detail was not swirled but scrambled horizontally at the curl map's own
// frequency while staying coherent vertically — a comb of vertical filaments on every cloud edge.
//
// Measured in the curl field's OWN correlation length instead, so CurlStrength = 1 sits exactly at
// the folding bound and every authored value below it is a genuine swirl. On Clouds_UEShowcase the
// authored 0.35 now displaces by at most 49 m, which is the amplitude the frames show as turbulent
// rather than combed.
vec3 CloudDetailWarpedPos(vec3 worldPos, float heightFraction, float cellHeight)
{
    vec3 curl = (texture(u_CurlNoise, vec2(worldPos.x, worldPos.z) / u_CurlTileSize).rgb - 0.5f) *
                CLOUD_CURL_DECODE_SCALE;
    float curlUnit = u_CurlTileSize / (CLOUD_CURL_FINEST_PERIOD * CLOUD_CURL_DECODE_MAX);
    return CloudDetailSamplePos(worldPos, heightFraction) +
           vec3(curl.x, 0.0f, curl.y) * (u_CurlStrength * curlUnit * (1.0f - cellHeight));
}

// THE DETAIL COMPOSITE — the whole of it, and the ONE copy of it (see the header note).
//
// In: the three fields a Nubis3 modelling NVDF carries per voxel, however they were obtained —
//   @p profile       the Dimensional Profile: interior depth, 1 in the core, 0 at and outside the
//                    surface. Derived here as `gradient x coverage x baseShape`; fetched from the `.r`
//                    channel of a baked volume in the voxel branch.
//   @p detailType    0 = wispy, 1 = billowy (deck p.108). A height ramp here; the `.g` channel there.
//   @p densityScale  the linear per-voxel density multiplier (deck p.118). The weather map's `.a` here;
//                    the `.b` channel there.
//   @p cellHeight    where in the CLOUD (not the layer) this sample sits, in [0,1]. The per-cell band's
//                    own fraction here; the volume's own local height there.
// Out: the eroded density in [0,1].
//
// @p stepLength is the march's own stride at this sample, in world units. It is not a distance in
// disguise: both the erosion's own amplitude and the near-field band's are statements about the SAMPLING
// RATE here (CloudNyquistWeight), and the same distance carries a different rate on every quality tier.
float CloudDensityErode(vec3 worldPos, float heightFraction, float cellHeight, float profile,
                        float detailType, float densityScale, float distanceFromCamera, float stepLength)
{
    float density = profile;

    // ---- HOW MUCH OF THE EROSION THIS SAMPLE IS ENTITLED TO ------------------------------------------
    //
    // The erosion is a THRESHOLD — the remap below cuts every density under `noiseComposite *
    // DetailStrength` to exactly zero — driven by a field the far march cannot resolve. At 1-3 degrees of
    // elevation on Clouds_UEShowcase the stride is 700 m and the detail volume's amplitude-weighted
    // structure is 391 m (fine pair) and 781 m (coarse pair): 3.6 and 1.8 times past their own Nyquist
    // limits. A threshold on an unresolvable field is a coin toss per sample, the entry dither
    // gives every ray its own lattice phase, and the result was a band of vertical shreds along the
    // horizon that survived every previous pass because each half of it is individually correct.
    //
    // Measured: killing the erosion outright (Detail Strength 0) dropped the pixel-to-pixel horizontal
    // contrast of that band from 1.29 to 0.59 of a 0-255 level — below the untouched sky above it — while
    // quadrupling the search rate or the step budget changed it by less than 0.01. The erosion is the
    // whole of it.
    //
    // So each channel pair carries only what the local stride resolves, and past its limit it carries the
    // volume's MEAN instead of a sample of it (CLOUD_DETAIL_MEAN_LEVEL). Fading to the mean and not to
    // zero is what keeps this a filtering step rather than a fade: the expected cut is unchanged, so the
    // far deck keeps its mass and loses only the instance nobody could reconstruct.
    // The pairs fade separately because they run at different periods — see the two constants.
    //
    // AND THE COARSE PAIR NO LONGER FADES AT ALL — IT CHANGES SCALE. Fading to the mean keeps the deck's
    // MASS and throws away its SILHOUETTE, and a coverage island with no erosion on it is a 2-D field
    // extruded between a flat base and a flat top: a box. That, and not the march, is what made the far
    // sky a wall of cubes (CloudGeometry.glslh's CLOUD_WEATHER_CELLS_OVERHEAD note carries the
    // ground-truth probe and the knock-out table). CloudErosionLodTile picks a COARSER tile for the same
    // one fetch — the coarsest structure the local stride still resolves in full — so the erosion follows
    // the stride out instead of switching off, and the silhouette survives to where the deck now ends
    // (CloudAutoFadeEnd). The fine pair still fades to the mean, at its own period, exactly as before.
    //
    // BIT-IDENTICAL WHERE THE AUTHORED TILE IS ALREADY RESOLVABLE, which is every near sample and the
    // whole of any scene whose deck ends before its detail does: there the max() inside
    // CloudErosionLodTile returns u_DetailTileSize itself, so all three expressions below and the fetch
    // coordinate further down are the text they were. The CloudMath suite asserts it rather than
    // asserting that it "should" hold.
    float lodTile       = CloudErosionLodTile(u_DetailTileSize, CLOUD_DETAIL_EROSION_LOW_PER_TILE, stepLength);
    float erosionCoarse = CloudNyquistWeight(lodTile / CLOUD_DETAIL_EROSION_LOW_PER_TILE, stepLength);
    float erosionFine   = CloudNyquistWeight(lodTile / CLOUD_DETAIL_EROSION_HIGH_PER_TILE, stepLength);

    // The band's own gate, hoisted here because it decides whether the SECOND fetch below is paid for.
    // Past its limit a fine sample makes one detail fetch and one curl fetch and nothing else beyond the
    // four the cheap composition already made (weather, the two profile tables and the base shape).
    float bandWeight = CloudNyquistWeight(u_HighFreqFeatureSize, stepLength) * u_HighFreqStrength;

    // THE DETAIL FETCH IS UNCONDITIONAL, and it did not use to be: the far field skipped both it and the
    // curl fetch once `erosionCoarse` reached zero, which is the two fetches per far sample that the LOD
    // tile above now spends. It bought a deck with no silhouette, and the deck it bought them back for is
    // a much shorter one — the layer now ends where its erosion does rather than at the planet's
    // geometric horizon (CloudAutoFadeEnd), so there is far less far field left to pay for.
    // Docs/Clouds/DECK_SCALE_DECISION.md D5 measured the two changes together and put the cost inside the
    // baseline's own run-to-run spread; the fetch count is what to look at first if that is ever revisited.
    //
    // `erosionCoarse` is 1 by construction now (CloudErosionLodTile chooses the tile that makes it so)
    // and is still READ rather than assumed, so that retuning the LOD rule cannot silently leave a mix
    // weight behind. `erosionFine` is the one that still moves.
    vec3 detailPos = CloudDetailWarpedPos(worldPos, heightFraction, cellHeight);

    // The channel pairs mixed toward the volume's MEAN by THEIR OWN weight: R and B run at the coarse
    // period and G and A at the fine one (CloudDetailTexel), so the ordering of the two weights is what
    // puts a band of half-resolved erosion between the near field and the far one instead of a step.
    vec4 sampled = textureLod(u_DetailNoise, detailPos / lodTile, 0.0f);
    vec4 detail  = mix(vec4(CLOUD_DETAIL_MEAN_LEVEL, CLOUD_DETAIL_MEAN_LEVEL, CLOUD_DETAIL_MEAN_LEVEL,
                            CLOUD_DETAIL_MEAN_LEVEL),
                       sampled, vec4(erosionCoarse, erosionFine, erosionCoarse, erosionFine));

    // Two erosion families: wispy (the low pair of channels) and billowy (the high pair), blended by the
    // authored Detail Type. Billow takes over as the sample gets denser, which is why the blend gradient
    // is a power of the density rather than a constant.
    float wispy          = mix(detail.r, detail.g, density);
    float billowGradient = pow(clamp(density, 0.0f, 1.0f), u_BillowGradientPower);
    float billowy        = mix(detail.b, detail.a, billowGradient) * u_BillowNoiseScale;

    float noiseComposite = mix(wispy, billowy, detailType);

    // THE NEAR-FIELD BAND: ridged folds of the same two channels, at their OWN tile and gated by the
    // step length the march is taking here.
    //
    // It used to be folded out of `detail` — the fetch above, at the DETAIL tile. Ridging a signal
    // creases it but adds no information: at the showcase's 4 km detail tile the band's content was the
    // same 62 m structure the erosion already carried, so a third band existed in the code and not in
    // the picture. Turning HighFreqStrength off changed nothing visible, which is what a dead knob looks
    // like from the outside.
    //
    // Its own tile, derived from the feature size the artist asks for: the fold's finest content is
    // CLOUD_DETAIL_RIDGED_FINEST_PER_TILE creases across a tile, so a tile of that many feature-sizes
    // puts the band exactly where it was asked for. The second fetch is the price, and it is paid only
    // where the band can actually be seen — CloudNyquistWeight (computed at the top of this function, with
    // the erosion's own two gates) is zero everywhere the march is at or below its own Nyquist limit for
    // that size, which past a couple of kilometres is everywhere.
    if (bandWeight > 0.0f)
    {
        float bandTile = u_HighFreqFeatureSize * CLOUD_DETAIL_RIDGED_FINEST_PER_TILE;
        vec4  band     = textureLod(u_DetailNoise, detailPos / bandTile, 0.0f);

        float hfWisps   = 1.0f - pow(abs(abs(band.g * 2.0f - 1.0f) * 2.0f - 1.0f), u_HighFreqWispSharpness);
        float hfBillows = pow(abs(abs(band.a * 2.0f - 1.0f) * 2.0f - 1.0f), u_HighFreqBillowSharpness);
        float highFreq  = clamp(mix(hfWisps, hfBillows, detailType), 0.0f, 1.0f);
        noiseComposite  = mix(noiseComposite, highFreq, clamp(bandWeight, 0.0f, 1.0f));
    }

    // THE CUT, widened by the part of the threshold this sample could not see.
    //
    // The composite is LINEAR in the four fetched channels for a fixed density and detail type, so
    // whatever weight it applied to their mean it applies to their spread: one scalar, no second
    // composite. What is unresolved is the share the gates discarded, and the two pairs discarded
    // different shares — the mean of the two weights is the composite's own, to the same order as the
    // rest of this approximation.
    float compositeScale = mix(1.0f, u_BillowNoiseScale, detailType);
    float resolved       = 0.5f * (erosionCoarse + erosionFine);
    float lostSpread     = CLOUD_DETAIL_SD_LEVEL * compositeScale * (1.0f - resolved);

    density = CloudErodeDensity(density, noiseComposite * u_DetailStrength, lostSpread * u_DetailStrength);

    // The weather map's density-scale channel. Nubis3 p. 118 applies it LINEARLY and puts the power only
    // inside the sharpening lerp:
    //
    //     uprezzed_density *= inDensityScale;
    //     uprezzed_density  = pow(uprezzed_density, lerp(0.3, 0.6, max(EPS, pow(saturate(inDensityScale), 4))));
    //
    // This site multiplied by scale^4 instead, which is a transcription error inherited from the reference
    // project rather than from the paper. It compressed the channel's effect eightfold at the low end and
    // forced CloudWeather.shader to write the channel into [0.5, 1] as a workaround. With the paper's form
    // the weather pass emits the full [0, 1] range again, the channel provides the per-cell density
    // variety the deck's third NVDF channel exists for, and Density Scale Power is once again the
    // exponent it is named after.
    float scale = clamp(densityScale, 0.0f, 1.0f);
    density *= scale;
    density = pow(density, mix(u_DensitySharpenLow, u_DensitySharpenHigh,
                               max(pow(scale, u_DensityScalePower), 1e-4f)));

    // Distance softening: an ARTISTIC far-field density curve — `d^0.5 * 0.666` at full strength — and
    // NOT this file's answer to distance aliasing, whatever this comment used to claim. Two things have
    // replaced that claim and one has been measured out of it:
    //
    //   * CloudNyquistWeight above is what attenuates far detail now, by the march's own sampling rate
    //     rather than by an authored distance.
    //   * the argument that a real mip chain would do it better was TESTED IN PHASE 2 and refused. A 3D
    //     mip generator was written and the detail volume given eight levels; selecting the sample's
    //     level from the stride cost Clouds_TwoLayerShowcase's cirrus sheet 20.2 RMS levels of 255 (the
    //     erosion is a THRESHOLD applied after the fetch, so filtering the fetch removes mass in patches
    //     rather than noise, and the temporal stage is the real reconstruction), while any bias gentle
    //     enough to spare the sheet left the far deck within 1.4 RMS of unfiltered. The chain was
    //     removed. Docs/Clouds/VOXEL_CLOUD_PATH.md §4.4 carries the numbers so nobody rebuilds it.
    //   * this curve itself is weak: on the Clouds_UEShowcase horizon — 8 km to 45 km, the frame it
    //     should be doing the most work in — turning it off entirely moves the whole frame by 0.86 RMS
    //     levels with a 12-level peak, and the far band's horizontal contrast by 0.801 -> 0.785.
    //
    // Kept, because 12 levels in a third of the pixels is a grade an artist can reach for. Described
    // honestly, because it is not the thing standing between this sky and aliasing.
    float soften = CloudRemapRange(distanceFromCamera, u_SofteningStartDistance, u_SofteningEndDistance,
                                   0.0f, 1.0f) * u_DistanceSoftening;
    density = pow(density, mix(1.0f, 0.5f, soften)) * mix(1.0f, 0.666f, soften);

    // Near fade: stops the screen filling with white the instant the camera enters a cloud.
    density *= CloudRemapRange(distanceFromCamera, u_NearFadeStart, u_NearFadeEnd, u_NearFadeMinDensity, 1.0f);

    // Heavier tops. Centred on the middle of the layer so the bias redistributes density rather than
    // scaling the whole cloud, and clamped because the range reaches 2.
    density *= max(1.0f + u_DensityHeightBias * (cellHeight - 0.5f), 0.0f);

    return clamp(density, 0.0f, 1.0f);
}

// Fine tier: the cheap composition above, plus the whole detail composite. Returns x = the eroded (full)
// density, y = the unerroded profile — the march needs BOTH at every shaded sample (the profile drives
// the in-scatter probability and the ambient occlusion, CLD-106), and computing them in one evaluation is
// two texture fetches cheaper per sample than a separate CloudDensityCheap call would be.
vec2 CloudDensitySampleProcedural(vec3 worldPos, float heightFraction, float distanceFromCamera,
                                  float stepLength)
{
    vec4 weather = CloudSampleWeather(worldPos);
    if (weather.r <= 0.0f)
        return vec2(0.0f, 0.0f);

    vec2  band    = CloudCellBand(worldPos);
    float profile = CloudDensityCheapFrom(weather, band, worldPos, heightFraction);
    if (profile <= 0.0f)
        return vec2(0.0f, 0.0f);

    // Everything below that asks "where in the cloud is this sample" asks the CELL, not the layer. A
    // base, a growing top and a heavy core are properties of a cloud; once cells occupy different slabs
    // of the layer, a term keyed to layer height gives a cell sitting in the lower third no top at all
    // and a cell sitting in the upper third no base. At Cloud Height Variance 0 this is the same number
    // as the layer height, so no sky authored before per-cell bands moves.
    float cellHeight = clamp(CloudProfileCellHeight(heightFraction, band), 0.0f, 1.0f);

    // The deck authors Detail Type per voxel with a physical rule (p.92): "Increasing Density = Layered
    // Billows, Decreasing Density = Curly Layered Wisps" — condensation billows on the growing tops,
    // evaporation shreds the bases and edges into curls. The procedural proxy for "where is density
    // increasing" is HEIGHT: convection grows upward, entrainment eats the base. A constant bias gave
    // every altitude the same 50/50 blend, which is why the whole cloud rendered as uniform fibre. A
    // BAKED volume does not need the proxy — it carries the authored answer per voxel, which is the whole
    // reason the channel exists.
    float detailType = clamp(u_DetailTypeBias + (cellHeight - 0.35f) * 0.9f, 0.0f, 1.0f);

    float density = CloudDensityErode(worldPos, heightFraction, cellHeight, profile, detailType, weather.a,
                                      distanceFromCamera, stepLength);
    return vec2(density, profile);
}

#endif // CLOUD_DENSITY_PROCEDURAL_GLSLH
