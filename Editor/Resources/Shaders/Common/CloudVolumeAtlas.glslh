// The hero-cloud atlas ARITHMETIC, and nothing else — no sampler, no buffer, no engine state.
//
// WHY IT IS ITS OWN FILE. This is the GLSL mirror of Engine/Graphic/Clouds/CloudVolumeAtlasLayout.hpp,
// and phase 1a's handover named it as the single thing most worth testing: the clamp below is the only
// thing keeping one hero cloud's voxels out of another's tile, and a clamp that is subtly wrong renders
// as a stripe of the wrong cloud rather than as an error. Common/CloudDensityVoxel.glslh — which does
// declare a sampler and a storage buffer — includes this file, so the maths can be compiled AS C++ by
// Desert/Tests/Engine/CloudVolume and compared, value for value, against the C++ original.
//
// The text is written in the GLSL/C++ intersection: `vec3`, `clamp`, `floor`, `mod`, and float literals
// with an `f` suffix. Anything outside that intersection breaks one of the two builds immediately, which
// is the property that keeps the mirror honest.

#ifndef CLOUD_VOLUME_ATLAS_GLSLH
#define CLOUD_VOLUME_ATLAS_GLSLH

// The shipped geometry, mirroring CloudVolumeAtlasLayout's defaults: eight tiles of 128 x 128 x 64
// RGBA8, laid out 4 x 2 x 1 into a 512 x 256 x 64 atlas of 32.00 MiB (teamlead Q2). The world extent a
// tile covers is deliberately NOT here — it is a per-instance transform.
const vec3 CLOUD_VOLUME_TILE_DIMS  = vec3(128.0f, 128.0f, 64.0f);
const vec3 CLOUD_VOLUME_TILE_COUNT = vec3(4.0f, 2.0f, 1.0f);

// Tile index -> the voxel coordinate of the tile's corner. X varies fastest, then Y, then Z, exactly as
// CloudVolumeAtlasTileOrigin orders them and exactly as the voxel payload itself is ordered.
//
// The layout arrives as arguments rather than being read from the constants above so that a test can
// drive degenerate and asymmetric geometries through THIS code instead of through a paraphrase of it.
vec3 CloudVolumeAtlasTileOriginOf(vec3 tileDims, vec3 tileCount, float tileIndex)
{
    float x = mod(tileIndex, tileCount.x);
    float y = mod(floor(tileIndex / tileCount.x), tileCount.y);
    float z = floor(tileIndex / (tileCount.x * tileCount.y));
    return vec3(x, y, z) * tileDims;
}

// Local [0,1]^3 across the tile's own box -> the UVW to hand a texture() call on the atlas.
//
// TWO CLAMPS, AND NEITHER IS REDUNDANT.
//
//   1. `local` is clamped to [0,1] because it arrives from a world->local transform and is NOT in range:
//      a ray steps outside an instance's box constantly, and the answer there has to be a legal in-tile
//      texel rather than whatever the REPEAT sampler would have wrapped to. (Every 3D sampler this engine
//      creates is LINEAR/REPEAT and VulkanImage VERIFIES it — correct for the tiling noise that is the
//      rest of our volume usage, wrong for a bounded hero cloud. The teamlead's Q4 answer is to clamp
//      here rather than relax that policy, which makes the clamp OUR code.)
//
//   2. The TEXEL is then clamped to the band [0.5, dim-0.5] inside its own tile. This is the one that
//      matters and it must not be "simplified away": without it a tap at the very edge of a tile has a
//      trilinear pair whose second sample lands in the NEIGHBOUR's first texel — one hero cloud bleeding
//      into another, which is a defect nobody would diagnose quickly. With it, both taps of every
//      trilinear pair have an index inside this tile.
//
// The `.dvol` guard shell (BakeCloudVolume refuses to write a volume whose outermost voxel shell is not
// empty) is the second, deliberately redundant half of the same guarantee.
vec3 CloudVolumeAtlasUvwOf(vec3 tileDims, vec3 tileCount, float tileIndex, vec3 local)
{
    vec3 origin = CloudVolumeAtlasTileOriginOf(tileDims, tileCount, tileIndex);

    // [0,1] over the tile becomes [0, dim] in the tile's own texel space, then the half-texel band.
    vec3 texel = clamp(local, vec3(0.0f), vec3(1.0f)) * tileDims;
    texel      = clamp(texel, vec3(0.5f), tileDims - vec3(0.5f));

    return (origin + texel) / (tileDims * tileCount);
}

vec3 CloudVolumeAtlasUvw(float tileIndex, vec3 local)
{
    return CloudVolumeAtlasUvwOf(CLOUD_VOLUME_TILE_DIMS, CLOUD_VOLUME_TILE_COUNT, tileIndex, local);
}

// Whether a local coordinate is inside the instance's own box. THE cheap rejection: a ray that is nowhere
// near a hero cloud pays one matrix multiply and this test per instance, and never touches the atlas.
bool CloudVolumeInsideBox(vec3 local)
{
    return local.x >= 0.0f && local.x <= 1.0f && local.y >= 0.0f && local.y <= 1.0f && local.z >= 0.0f &&
           local.z <= 1.0f;
}

#endif // CLOUD_VOLUME_ATLAS_GLSLH
