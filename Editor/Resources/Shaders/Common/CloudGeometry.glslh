// Geometry, scheduling and lighting maths for the volumetric cloud raymarch — the ONE source of truth.
//
// This file is compiled TWICE, from the same text:
//   * as GLSL, by Programs/Clouds/CloudRaymarch.shader;
//   * as C++, by Desert/Tests/Engine/CloudMath/CloudGeometryReference.hpp, which the CloudMath tests drive.
// Vulkan does not run in the development environment, so the marched picture cannot be looked at. A CPU
// re-implementation would only prove that the copy agrees with itself. Sharing the text means a passing
// test is a statement about the code the GPU runs. The arrangement is the one Common/CloudNoise.glslh
// already established for the noise.
//
// The price is a restricted dialect — the GLSL/C++ intersection:
//   * no swizzles (glm's are proxies), no `out` parameters, no arrays, no `inline`, no namespaces;
//   * float literals carry the `f` suffix so C++ does not silently widen;
//   * a struct is returned by value through a NAMED LOCAL whose fields are assigned one at a time.
//     GLSL's `Type(a, b, c)` constructor call is not C++ (parenthesised aggregate initialisation is a
//     C++20 feature the toolchain in use does not implement), and C++'s `Type{a, b, c}` is not GLSL;
//     assignment is the form both languages accept;
//   * functions are defined before use, C-style, because GLSL has no forward declarations.
//
// SCALE, and why every distance here is a KILOMETRE.
// The engine's world unit is one centimetre and the planet radius is 6360 km = 6.36e8 world units. The
// quadratic of a ray/sphere test carries r^2, which at that scale is 4.0e17 — an ulp of 3.2e10 in a
// 24-bit mantissa, i.e. not a single significant digit of the discriminant survives. In kilometres
// r^2 is 4.0e7 with an ulp of 4, which is workable.
//
// It is NOT sufficient on its own, and that is the part the requirement did not say. `dot(c,c) - r*r`
// subtracts two numbers around 4.0e7 to produce 2*R*altitude, which for a camera 2 m up is 25 km^2 —
// the cancellation throws away four of the seven digits. Every intersection below is therefore written
// in the ALGEBRAICALLY EXPANDED form, where the same quantity comes out as a sum of small terms and no
// cancellation happens at all:
//
//      |o - C|^2 - (R+a)^2  ==  dot(o,o) + 2*R*o.y - 2*R*a - a*a          with C = (0, -R, 0)
//
// and the camera-relative rule of the requirement falls out of it: the ray origin IS the camera, the
// centre is only ever touched through R multiplied by a small number, and no planet-scale magnitude is
// ever formed.

#ifndef CLOUD_GEOMETRY_GLSLH
#define CLOUD_GEOMETRY_GLSLH

const float CLOUD_PI = 3.141592653589793f;

// One world unit is one centimetre (Common::Units), so a kilometre is 100 000 of them. Both directions
// are spelled out rather than left to the reader: the raymarch converts in both, and a stray reciprocal
// is a 1e10 error that still renders something.
const float CLOUD_WORLD_UNITS_PER_KM = 100000.0f;

float CloudKmFromWorld(float worldUnits)
{
    return worldUnits * (1.0f / CLOUD_WORLD_UNITS_PER_KM);
}

float CloudWorldFromKm(float km)
{
    return km * CLOUD_WORLD_UNITS_PER_KM;
}

// Extinction of a FULLY DENSE cloud per WORLD UNIT, at ExtinctionScale = 1. Real cloud extinction is
// around 0.05 per metre, which is 5e-4 per centimetre — so one optical depth accumulates over about
// 20 m of solid cloud, and a kilometre of it is opaque many times over. ExtinctionScale then reads as a
// multiplier on a physical quantity rather than as an arbitrary number, which is the difference between
// "1.0 looks right" and "1.0 IS right".
//
// The reference had the extinction coefficient as a literal 1.0 in the accumulation line and a
// DENSITY_SCALE define that was never referenced anywhere (RESEARCH_REFERENCE J.3 #12).
const float CLOUD_EXTINCTION_PER_WORLD_UNIT = 0.0005f;

// Rescales `v` from [lo,hi] onto [newLo,newHi], clamped to that range. Named with a Range suffix so it
// cannot collide with Common/CloudNoise.glslh's CloudRemap01 when a shader includes both.
float CloudRemapRange(float v, float lo, float hi, float newLo, float newHi)
{
    float d = hi - lo;
    // A zero-width source range is a division by zero on the GPU: inf, then NaN through the mix, and a
    // NaN pixel survives every blend it touches. Collapse to the low end instead.
    if (abs(d) < 1e-6f)
        return newLo;
    return newLo + clamp((v - lo) / d, 0.0f, 1.0f) * (newHi - newLo);
}

// ---- The weather field's scale ----------------------------------------------------------------------

// How many DOMINANT coverage cells fit across one weather tile. Programs/Clouds/CloudWeather.shader
// starts its FBM here — for the coverage field, for the type field and for the per-cell height NDFs, all
// of which describe the same cell and so must start at the same period. Defined in this file, and not as
// a literal over there, because the tile size that goes with it is decided on the CPU and the two have
// to agree or the sky is calibrated against a cell size nothing else believes in.
const float CLOUD_WEATHER_BASE_PERIOD = 8.0f;

// The tile that gives a GROUND OBSERVER a believable sky, from the layer's own geometry.
//
// The relation nothing in this renderer expressed until now: a camera on the ground looking at elevation
// E meets the layer's mid-altitude at a horizontal range of mid / tan(E), so the whole sky above E is a
// disc of that radius on the weather map. If the dominant coverage cell is comparable to that disc, the
// observer sees ONE cell overhead — and at any coverage below 1 that cell is as likely to be a hole as a
// cloud. Clouds_UEShowcase authored a 60 km tile over a layer at 1.5-5 km: a 7.5 km dominant cell
// against a 5.6 km disc above 30 degrees, and the zenith rendered as empty blue while the horizon
// carried a dense band. The audit's own §M.2 warning is about shrinking the 3D NOISE tiles; this is the
// 2D weather tile, which is a different quantity and wants the opposite treatment.
//
// Fixing the elevation at 20 degrees — the height at which the showcase's sky measurably went from a
// dense horizon band to empty blue, so it is the boundary being fixed rather than a round number — and
// asking for CELLS_OVERHEAD cells across that disc rather than one gives
//
//     cell <= (mid / tan 20) / CELLS_OVERHEAD        and        tile = BASE_PERIOD * cell
//
// which is a single multiple of the layer's mid-altitude. Three cells is the smallest count that can
// show cloud, gap and cloud overhead.
//
// BOTH DIRECTIONS FAIL, and the frames say where. Solving for 30 degrees instead gives Clouds_UEShowcase
// a 15 km tile: the zenith fills, and the horizon becomes a wall of cells small enough that the step
// schedule out there samples each of them four times — a boiling mush rather than a cloudscape. 20
// degrees gives 23.8 km, at which the same frame carries cumulus with readable cauliflower tops AND a
// zenith with cloud in it. That is the whole width of the usable band, which is why this is derived from
// the layer and not left to be authored per scene.
const float CLOUD_WEATHER_OVERHEAD_COT = 2.7474774f; // 1 / tan(20 degrees)
const float CLOUD_WEATHER_CELLS_OVERHEAD = 3.0f;

float CloudAutoWeatherTileSize(float layerBottomAltitude, float layerThickness)
{
    float mid = max(layerBottomAltitude + 0.5f * layerThickness, 1.0f);
    return mid * (CLOUD_WEATHER_BASE_PERIOD * CLOUD_WEATHER_OVERHEAD_COT / CLOUD_WEATHER_CELLS_OVERHEAD);
}

// ---- Ray / sphere ----------------------------------------------------------------------------------

// The two signed roots of a ray/sphere intersection. SIGNED, not absolute: the reference's slab test
// took abs() of every plane distance and therefore reported hits on geometry BEHIND the camera
// (RESEARCH_REFERENCE J.3 #6). A negative root here means "behind me", and every caller below reads it
// that way.
struct CloudSphereHit
{
    bool  Hit;
    float T0; // near root, may be negative
    float T1; // far root, may be negative
};

// Intersection with a sphere CONCENTRIC WITH THE PLANET whose surface sits `altitudeKm` above the
// planet surface. Everything is in kilometres and relative to the camera:
//
//   originKm   camera position in the world frame, in km. The world origin lies ON the planet surface
//              with +Y up, so the planet centre is (0, -planetRadiusKm, 0) and never has to be formed.
//   dir        normalized view direction.
//
// The expanded quadratic is the whole point of this function — see the header comment.
CloudSphereHit CloudIntersectAltitudeSphere(vec3 originKm, vec3 dir, float planetRadiusKm, float altitudeKm)
{
    // b = dot(dir, centre - origin), written out: centre - origin = (-o.x, -R - o.y, -o.z).
    float b = -(dot(dir, originKm) + dir.y * planetRadiusKm);

    // c = |centre - origin|^2 - (R + a)^2, expanded so the R^2 terms cancel SYMBOLICALLY instead of
    // numerically. Every surviving term is small: dot(o,o) is the camera's distance from the origin
    // squared, and 2*R*o.y is twice the radius times the altitude.
    float c = dot(originKm, originKm) + 2.0f * planetRadiusKm * originKm.y -
              (2.0f * planetRadiusKm * altitudeKm + altitudeKm * altitudeKm);

    CloudSphereHit hit;
    hit.Hit = false;
    hit.T0  = 0.0f;
    hit.T1  = 0.0f;

    float disc = b * b - c;
    if (disc < 0.0f)
        return hit;

    float s = sqrt(disc);
    hit.Hit = true;
    hit.T0  = b - s;
    hit.T1  = b + s;
    return hit;
}

// The segment of the view ray that lies inside the cloud shell. Distances are in kilometres, measured
// from the camera along `dir`, and TEnter is never negative: the part of the shell behind the camera is
// not marched.
struct CloudShellHit
{
    bool  Hit;
    float TEnter;
    float TExit;
};

// One branch structure for every configuration — camera below the layer, inside it, above it, and
// looking up, down, along the horizon or away from the planet.
//
//   * no forward intersection with the OUTER sphere at all -> the shell is behind us: a miss;
//   * the ray meets the INNER sphere ahead      -> the shell ends where the ray dives under the layer;
//   * the ray starts INSIDE the inner sphere    -> the shell starts where the ray climbs out of it;
//   * the ray misses the inner sphere entirely  -> the shell is the whole outer chord.
CloudShellHit CloudShellBounds(vec3 originKm, vec3 dir, float planetRadiusKm, float bottomKm, float thicknessKm)
{
    CloudShellHit shell;
    shell.Hit    = false;
    shell.TEnter = 0.0f;
    shell.TExit  = 0.0f;

    CloudSphereHit outer = CloudIntersectAltitudeSphere(originKm, dir, planetRadiusKm, bottomKm + thicknessKm);
    if (!outer.Hit || outer.T1 <= 0.0f)
        return shell;

    CloudSphereHit inner = CloudIntersectAltitudeSphere(originKm, dir, planetRadiusKm, bottomKm);

    float tEnter = max(outer.T0, 0.0f);
    float tExit  = outer.T1;

    if (inner.Hit && inner.T1 > 0.0f)
    {
        if (inner.T0 > 0.0f)
            tExit = inner.T0; // the ray dives below the layer before leaving the outer shell
        else
            tEnter = inner.T1; // the camera is below the layer; the shell begins where we climb out
    }

    if (tExit <= tEnter)
        return shell;

    shell.Hit    = true;
    shell.TEnter = tEnter;
    shell.TExit  = tExit;
    return shell;
}

// Normalized height inside the layer, UNCLAMPED: 0 at the bottom surface, 1 at the top, negative below
// and greater than 1 above. Derived from the DISTANCE TO THE PLANET CENTRE, not from world Y — over
// 150 km of cloudscape the shell curves away by more than a kilometre, and a flat-Y height would flatten
// every distant cloud into the layer floor.
//
// Unclamped because the light march needs to know that a sample has left the layer: clamping first turns
// a shadow sample a kilometre above the cloud tops into one sitting exactly ON them, which shadows every
// cloud with a copy of itself. The view march, whose samples are inside the shell by construction, wants
// the clamped form below.
//
// Written in the expanded form for the same reason as the intersection above.
float CloudLayerHeight(vec3 positionKm, float planetRadiusKm, float bottomKm, float thicknessKm)
{
    // |p - C| - R, with C = (0,-R,0), through the identity (|v|^2 - R^2) / (|v| + R). The numerator is
    // the expanded, cancellation-free form; the denominator is ~2R and loses nothing.
    float num = dot(positionKm, positionKm) + 2.0f * planetRadiusKm * positionKm.y;
    float den = sqrt(dot(positionKm, positionKm) + 2.0f * planetRadiusKm * positionKm.y +
                     planetRadiusKm * planetRadiusKm) +
                planetRadiusKm;
    float altitude = num / max(den, 1e-4f);
    return (altitude - bottomKm) / max(thicknessKm, 1e-6f);
}

float CloudHeightFraction(vec3 positionKm, float planetRadiusKm, float bottomKm, float thicknessKm)
{
    return clamp(CloudLayerHeight(positionKm, planetRadiusKm, bottomKm, thicknessKm), 0.0f, 1.0f);
}

// ---- Layers: which slice, and in what order the ray meets them ---------------------------------------

// The w coordinate of @p layer's slice in a @p layerCount-deep volume.
//
// The weather map, the profile map, the profile table and the cloud shadow map are all one image per
// quantity with one SLICE per cloud layer, rather than one image per layer per quantity. The engine
// refuses arrayed samplers on purpose (ShaderReflection.RefusesArrayedImagesInsteadOfGuessing) and its own
// answer to "N of the same thing" is a volume with arithmetic addressing — the hero-cloud atlas is the
// precedent. One sampler also means one fetch: selecting between two 2D images would be a branch on a
// value that differs between pixels of the same wave, and this fetch runs up to seven times per shaded
// sample.
//
// TEXEL CENTRES, which is the whole content of this function. Every volume in the engine is sampled
// LINEAR/REPEAT (VulkanImage's AlwaysLinear policy), so a w half a texel off would blend the deck's
// coverage into the sheet's. At the centre the trilinear weight on the neighbouring slice is exactly
// zero, and the fetch returns that layer's texel and nothing else.
float CloudLayerSliceW(int layer, int layerCount)
{
    float count = max(float(layerCount), 1.0f);
    return (float(layer) + 0.5f) / count;
}

// ---- The march plan ----------------------------------------------------------------------------------

// One stretch of the view ray, and the cloud layer that owns it.
struct CloudMarchSegment
{
    float TEnter;
    float TExit;
    int   Layer;
};

// The most segments a straight ray through two DISJOINT concentric shells can need.
//
// Three, and the third is not padding. CloudShellBounds reports one CONSERVATIVE interval per shell — the
// first entry to the last exit — because a ray that dips below a layer and climbs back out crosses it
// twice. A camera above the upper layer looking down at a shallow angle produces exactly that: the upper
// shell's conservative interval spans the descent AND the ascent, and the lower shell's interval sits
// inside it. Marching the upper one whole and then the lower one would composite the lower deck BEHIND
// cloud that is in front of it.
//
// Splitting the containing interval at the contained one is EXACT rather than approximate: the pieces the
// split removes are the gap between the two altitude bands, where the outer layer's own height fraction
// is outside [0,1] and its density is zero by construction.
#define CLOUD_MAX_MARCH_SEGMENTS 3

// The ordered, disjoint segments of a ray through up to two shells. Arrays are outside the GLSL/C++
// intersection this file is written in, so the three are named members and CloudPlanSegment is the
// subscript.
struct CloudMarchPlan
{
    int               Count;
    CloudMarchSegment S0;
    CloudMarchSegment S1;
    CloudMarchSegment S2;
};

CloudMarchSegment CloudPlanSegment(CloudMarchPlan plan, int index)
{
    CloudMarchSegment segment = plan.S2;
    if (index == 0)
        segment = plan.S0;
    else if (index == 1)
        segment = plan.S1;
    return segment;
}

// Appends a segment to a plan if it has any length at all. A zero-length or inverted interval is not an
// error — it is what the split produces when the contained shell starts exactly where the containing one
// does — and dropping it here is what keeps every segment the plan reports genuinely marchable.
CloudMarchPlan CloudPlanAppend(CloudMarchPlan plan, float tEnter, float tExit, int layer)
{
    CloudMarchPlan next = plan;
    if (tExit <= tEnter)
        return next;

    CloudMarchSegment segment;
    segment.TEnter = tEnter;
    segment.TExit  = tExit;
    segment.Layer  = layer;

    if (plan.Count == 0)
        next.S0 = segment;
    else if (plan.Count == 1)
        next.S1 = segment;
    else if (plan.Count == 2)
        next.S2 = segment;
    else
        return next; // full: cannot happen for two disjoint shells, and silently growing would be worse

    next.Count = plan.Count + 1;
    return next;
}

// THE ORDER THE RAY MEETS THE LAYERS, as segments that are sorted by distance and do not overlap.
//
// Both properties are what makes the march composite correctly BY CONSTRUCTION: one transmittance
// accumulator walked front to back is "near over far" with nothing to sort afterwards, and no interval
// marched twice means no cloud counted twice.
//
// @p a and @p b are the two shells' conservative intervals; @p layerA and @p layerB name which layer each
// belongs to. Either may be a miss, in which case it contributes nothing.
CloudMarchPlan CloudPlanTwoShells(CloudShellHit a, int layerA, CloudShellHit b, int layerB)
{
    CloudMarchPlan plan;
    plan.Count = 0;
    plan.S0.TEnter = 0.0f;
    plan.S0.TExit  = 0.0f;
    plan.S0.Layer  = 0;
    plan.S1 = plan.S0;
    plan.S2 = plan.S0;

    if (!a.Hit && !b.Hit)
        return plan;

    if (!b.Hit)
        return CloudPlanAppend(plan, a.TEnter, a.TExit, layerA);

    if (!a.Hit)
        return CloudPlanAppend(plan, b.TEnter, b.TExit, layerB);

    // Order by entry distance. The near one is the one the eye reaches first, whichever altitude it is —
    // a camera above the deck meets the layers in the opposite order to a camera on the ground.
    CloudShellHit first     = a;
    CloudShellHit second    = b;
    int           firstId   = layerA;
    int           secondId  = layerB;
    if (b.TEnter < a.TEnter)
    {
        first    = b;
        second   = a;
        firstId  = layerB;
        secondId = layerA;
    }

    if (second.TExit <= first.TExit)
    {
        // CONTAINED: the ray dips through the second layer's band and climbs back out inside the first
        // layer's conservative span. Split the container around it.
        plan = CloudPlanAppend(plan, first.TEnter, second.TEnter, firstId);
        plan = CloudPlanAppend(plan, second.TEnter, second.TExit, secondId);
        plan = CloudPlanAppend(plan, second.TExit, first.TExit, firstId);
        return plan;
    }

    // DISJOINT, or overlapping at the ends. The clip is a no-op in the disjoint case, which is every
    // ground camera; where the two do overlap, the overlap lies in the gap between the altitude bands
    // and the first layer has no density there, so the clip loses nothing and keeps the pair disjoint.
    plan = CloudPlanAppend(plan, first.TEnter, min(first.TExit, second.TEnter), firstId);
    plan = CloudPlanAppend(plan, second.TEnter, second.TExit, secondId);
    return plan;
}

// ---- Step scheduling -------------------------------------------------------------------------------

// The near/far split of the step schedule, in WORLD UNITS (centimetres). Nubis3 grows its step as
// sqrt(distance) (p. 163: `adaptive_step = max(1, sqrt(d) * 0.08)` metres) because a cauliflower lobe is
// 100-200 m across wherever it is, while a linear schedule crosses that size a few kilometres out and
// renders everything beyond as step-sized mush. The deck can afford sqrt everywhere because its voxel
// domain is 4 km; ours is a 150 km shell, so the sqrt regime is bounded: inside FINE_RANGE the step obeys
// the sqrt law, beyond FAR_RANGE it is exactly the old linear schedule (the deck's own near/far logic,
// p. 171 — past that range the layer is a texture and finer sampling buys nothing), and between the two
// it blends monotonically. 10 km is where a ground camera actually looks at clouds; 25 km is past the
// distance-softening midpoint, where detail is deliberately attenuated anyway.
const float CLOUD_STEP_FINE_RANGE = 1000000.0f; // 10 km: sqrt regime, step <= 2 * minStep
const float CLOUD_STEP_FAR_RANGE  = 2500000.0f; // 25 km: pure linear schedule resumes

// Distance-adaptive step length, in WORLD UNITS. Steps grow with distance because a cloud a hundred
// kilometres away covers fewer pixels than one overhead, so the same angular error costs a longer step.
// The clamp is what makes MinStepSize and MaxStepSize mean what the Details panel says they mean.
//
// The sqrt term is scaled by minStep rather than by an absolute constant so the quality tiers keep their
// meaning: the fine step is minStep at the camera and exactly 2 * minStep at FINE_RANGE, for every tier.
// The min() against the linear schedule keeps the near tier from ever being COARSER than the old
// schedule (near the camera the linear term is the finer of the two), which is also what makes the blend
// below monotone for any growth >= 0: it interpolates from the smaller function to the larger one with a
// nondecreasing weight.
float CloudStepLength(float t, float minStep, float maxStep, float growth)
{
    float linear = minStep + growth * t;
    float fine   = min(minStep * (1.0f + sqrt(max(t, 0.0f) * (1.0f / CLOUD_STEP_FINE_RANGE))), linear);
    float w      = clamp((t - CLOUD_STEP_FINE_RANGE) * (1.0f / (CLOUD_STEP_FAR_RANGE - CLOUD_STEP_FINE_RANGE)),
                         0.0f, 1.0f);
    return clamp(mix(fine, linear, w), min(minStep, maxStep), max(minStep, maxStep));
}

// ---- The sampling-rate gate -------------------------------------------------------------------------

// How much of a field of a given feature size a sample may carry, from the step the march is taking
// THERE. This replaces authored distances (High Freq Fade Start / End were the first pair) with the
// relation those distances were an attempt to express, and it is the relation that decides, not the
// authoring.
//
// TWO CONSUMERS, ONE RELATION. The near-field ridged band was the first. The DETAIL EROSION itself is the
// second (Common/CloudDensityProcedural.glslh), and it is the one that decides what the horizon looks
// like: at 1-3 degrees of elevation a ray strides 700 m through a field whose amplitude-weighted
// structure is 390 m across. A field marched three and a half times past its own Nyquist limit is not
// rendered coarsely — it is a DIFFERENT field in every pixel, because the entry dither moves each ray's
// sample lattice by up to a coarse stride. That is what the ragged fringe of vertical shreds along the
// horizon was made of, and no amount of fading hides it, because the shreds ARE the cloud.
//
// A march samples the medium at intervals of S. Along the ray that is a sampling rate, and its Nyquist
// limit is a feature of size 2S: anything finer cannot be reconstructed and arrives as noise for the
// temporal resolve to average into mush. So a field whose content is `featureSize` across is
//
//     * fully carried where the march is at least twice oversampled for it, S <= featureSize / 4;
//     * gone at the Nyquist limit itself,                                  S >= featureSize / 2;
//     * ramped between.
//
// The audit measured the old arrangement (NUBIS3_FULL_AUDIT §5.3): the band ran to an authored 9 km,
// where its ~16 m features sit about five times below the step length — "it degrades into temporal
// shimmer that the resolve then averages into mush". Two authored distances cannot express this, because
// the step length is a function of the quality tier as well as of distance: the same 2.5-9 km fade is
// four times oversampled on Ultra and below Nyquist on Low. Reading the step itself is exact on every
// tier and stays exact if the schedule is ever retuned.
//
// WHAT THIS COSTS, measured rather than hoped: at the shipped High tier's MinStepSize of 15 m the
// schedule cannot go below 15 m anywhere, so a band finer than 60 m is never fully carried and one finer
// than 30 m is never carried at all. The band therefore ramps from about half strength at the camera to
// nothing a couple of kilometres out. Making it stronger means a finer near-field step, which is a
// perf trade rather than a maths one, and is not in this change.
//
// WHAT THE EROSION'S CONSUMER COSTS, on Clouds_UEShowcase's High tier and its 4 km detail tile: the
// coarse channel pair (781 m across) is fully carried to 24.0 km and gone by 47.0 km; the fine pair
// (391 m) is fully carried to 17.7 km and gone by 24.0 km. Inside 17.7 km BOTH weights are exactly 1,
// so the detail volume is sampled unmixed and CloudErodeDensity's spread is exactly 0 — the density is
// then bit for bit what it was before the gate existed, which is what keeps near clouds unchanged.
float CloudNyquistWeight(float featureSize, float stepLength)
{
    return CloudRemapRange(stepLength, 0.5f * max(featureSize, 1e-4f), 0.25f * max(featureSize, 1e-4f),
                           0.0f, 1.0f);
}

// THE EROSION CUT, with the threshold's UNRESOLVED spread folded into it.
//
// The cut is a hinge: `max(d - t, 0) / (1 - t)`, where t is the detail composite times Detail Strength.
// Where the march resolves the noise that sets t, the hinge is exactly right and this function IS it.
//
// Where it does not — the far field, past CloudNyquistWeight — the sample carries the noise's MEAN, and
// the mean of a hinge is not the hinge of a mean. Every sample whose density sits just under the mean
// threshold clamps to exactly zero and every sample just over it comes through at full strength; with a
// step's worth of optical depth behind each one (700 m at 0.0005 per centimetre is an opacity of about
// ten) that is a BINARY field, and which pixel lands on which side of it is decided by the entry dither.
// The picture is a deck of opaque columns with clear gaps between them: the ragged fringe again, in
// coarser clothes.
//
// So return the MEAN OF THE HINGE instead. Modelling the variation the sample no longer sees as uniform
// about t with half-width r = sqrt(3) s, so that its standard deviation is the measured s:
//
//     E_t[max(d - t, 0)] = 0                        d <= t - r
//                        = (d - t + r)^2 / (4r)     |d - t| <= r
//                        = d - t                    d >= t + r
//
// Continuous, continuously differentiable, and exactly the conditional mean of the hinge under that
// model — which is what the test pins, against a numerical average over the same window.
//
// R IS CLAMPED TO T, and that is not defensive. The threshold is a noise value in [0,1] times Detail
// Strength, so it cannot be negative; a symmetric window wider than t would put weight on negative
// thresholds, and a negative threshold ADDS density. Unclamped, a sample whose unerroded profile is
// barely above zero came back solid, which paints a faint fog over the whole shell. The widest symmetric
// window that stays non-negative keeps the mean exactly t and understates the spread where the threshold
// is small, which is the safe direction: less widening, never invented cloud.
//
// The bound the test pins follows from it: the result is never below the hinge and never above
// `d / (1 - t)`, so no spread can make a sample denser than an unerroded one. At s = 0 it is the hinge
// bit for bit, which is what leaves every near-field sample untouched.
float CloudErodeDensity(float density, float threshold, float thresholdSpread)
{
    float t = clamp(threshold, 0.0f, 1.0f);

    // A threshold at the top of the range leaves no range to remap onto, and dividing by it is the
    // inf-then-NaN CloudRemapRange guards against for the same reason. Collapsing to zero here is
    // exactly what that guard does, which is what keeps this function the hinge it replaced at every
    // input and not merely at the ones a test happens to sweep.
    if (1.0f - t < 1e-6f)
        return 0.0f;

    float r = min(1.7320508f * max(thresholdSpread, 0.0f), t);
    float d = density - t;

    float cut = max(d, 0.0f);
    if (r > 1e-6f && d > -r && d < r)
    {
        float u = d + r;
        cut     = u * u * (0.25f / r);
    }

    return clamp(cut / (1.0f - t), 0.0f, 1.0f);
}

// The empty-space skip, as a state machine over scalars.
//
// The reference skips empty space with a signed distance field baked into the alpha channel of its
// modelling volume (RESEARCH_REFERENCE C.3). We have no SDF and cannot have one: our density field is
// procedural, evaluated on the fly from a weather map and two noise volumes, so there is nothing to bake
// a distance to. What replaces it is two tiers plus the analytic shell bounds:
//
//   * outside the shell, zero samples — CloudShellBounds already clipped the ray;
//   * inside it, march at `stride * coarseMultiplier` evaluating only the CHEAP density (weather map x
//     height gradient x base shape: no detail fetch, no light march);
//   * on a non-zero cheap sample, step BACK one coarse stride and switch to the fine tier, so the
//     leading edge that the coarse stride jumped over is not cut off the front of every cloud;
//   * after `emptyBeforeCoarse` consecutive empty FINE samples, return to coarse.
//
// This is the Nubis1/2 miss-counting heuristic, and it needs no extra memory at all.
//
// BOTH TIERS MUST MEASURE THE SAME FIELD, and every defect this machine has produced came from them not
// doing so. `occupied` is the CHEAP density in both — weather x envelope x base shape — and the caller
// is what guarantees it: Programs/Clouds/CloudRaymarch.shader judges its fine samples by the profile
// CloudDensitySample returns beside the eroded density, not by the eroded density itself. See the note
// at that site for what happened when it did not.
//
// The first failure was a STALL. The coarse verdict was the cheap density and the fine verdict was the
// density AFTER erosion, and over most of a procedural cloudscape the cheap one is small but strictly
// positive while the eroded one is exactly zero. So the coarse tier said "cloud", the fine tier found
// nothing, and the two chased each other:
//
//     coarse hit at T -> rewind one coarse stride C -> emptyBeforeCoarse empty fine samples of stride F
//     -> back to coarse at T - C + E*F -> hit again -> rewind C -> fine at T - 2C + E*F
//
// which advances by (E - 2 * coarseMultiplier) fine strides per (E + 1) samples. At the shipped High
// tier — coarseMultiplier 4, emptyBeforeCoarse 8 — that is EXACTLY ZERO: the march stood still, burning
// nine samples per cycle to cover no ground, and every ray at an ordinary viewing elevation ran out of
// MaxSteps over open sky. It was invisible to the unit tests because they drive both tiers from ONE
// synthetic slab, so the two verdicts could not disagree. Measured on Clouds_UEShowcase at 24 degrees
// elevation: the whole frame budget-exhausted, `finished` false on essentially every pixel, and the
// exhaustion fade below then erased the cloud that had been integrated.
//
// Two properties cured the stall:
//
//   * A FRONTIER. The rewind is clamped to the furthest point the fine tier has already sampled, so no
//     interval is ever marched twice. This is what makes progress monotone rather than periodic.
//   * SEARCHING AT THE COARSE RATE. Until a fine excursion has found real density, it is still
//     SEARCHING, and there is nothing yet to resolve; it advances by the coarse stride. The first
//     non-empty sample rewinds one coarse stride (once, guarded by `Shaded`) and only then does the
//     excursion step at the fine stride, which is what resolves the cloud and its interior holes. A
//     false positive therefore costs `emptyBeforeCoarse` coarse strides of GROUND for
//     `emptyBeforeCoarse + 1` samples instead of standing still.
//
// The SECOND failure was the horizon fringe, and the disagreement was the same one seen from the far
// field: the fine tier's erosion holes made it hand control back mid-cloud, so the ray jumped a coarse
// stride — 2.8 km at 1-3 degrees of elevation — over cloud that the coarse tier itself called occupied,
// at a place chosen by the entry dither. Unifying the verdict on the cheap density removed it; the
// erosion still decides how much light a shaded sample scatters and no longer decides where the ray goes.
struct CloudMarchState
{
    float T;        // distance along the ray, world units
    float Frontier; // furthest distance the FINE tier has sampled; the rewind never goes behind it
    int   EmptyRun; // consecutive empty fine samples
    bool  Fine;     // false = coarse tier (cheap density only)
    bool  Shaded;   // this fine excursion has found real density at least once
};

// THE SEGMENT'S ENTRY AND WHERE SAMPLING STARTS ARE TWO DIFFERENT DISTANCES, and this machine needs
// both. It used to take one, and the caller handed it the dithered one — which deleted a per-pixel slab
// off the near face of every cloud layer.
//
// The march's first sample is dithered forward by up to one coarse stride, so that the coarse tier's
// decision boundary is not a fixed shell (the note at the dither site says why the coarse stride and not
// the fine one). A march samples nothing before its first sample, so that prefix is only ever integrated
// if a REWIND reaches back into it — and the rewind is floored twice, by this frontier and by
// CloudMarchAdvance's own `tEnter`. Both were fed the dithered start. The floor was therefore always at
// or above the first sample, the rewind could never reach behind it, and `[tEnter, tStart]` was not
// marched coarsely, not marched finely, and not skipped for any reason the field knows about: it was
// simply absent, by a length drawn from interleaved gradient noise.
//
// WHY IT HID FOR SO LONG. The deleted slab is `jitter * coarseStride` against the ray's chord through the
// layer. On the 3.5 km deck of Clouds_UEShowcase, met at 8 km with a 114 m coarse stride, that is 1.3% of
// an 8.6 km chord — inside the quadrature noise. On the 1.2 km cirrus sheet of Clouds_Cirrus, met at
// 25 km where the schedule has grown the stride to 865 m, it is 25% of a 3.5 km chord: a quarter of the
// cloud, removed per pixel by a fixed screen-space pattern. Measured at the interleaved-gradient-noise
// fundamental — 1.847 cloud-buffer pixels at 145.2 degrees, which is exactly where the cross-hatch sat —
// 0.38 grey levels on the cirrus sheet against 0.02 on the deck.
//
// Neither side was wrong alone, which is why three passes over this renderer walked past it. The dither
// is a correct lattice randomiser; the frontier is a correct guard against marching an interval twice.
// Wiring the guard to the dithered value turned "never march an interval twice" into "never march it
// once". The tests could not see it either: they drove the machine with tStart == tEnter, the single
// phase at which the two distances coincide.
//
// @param tEnter  the segment's true entry: the first distance at which this layer can carry density.
//                Nothing before it needs sampling, and nothing after it may go unsampled.
// @param tStart  where the first SAMPLE falls — tEnter dithered forward by up to one coarse stride.
CloudMarchState CloudMarchBegin(float tEnter, float tStart)
{
    CloudMarchState s;
    s.T        = tStart;
    s.Frontier = tEnter;
    s.EmptyRun = 0;
    s.Fine     = false;
    s.Shaded   = false;
    return s;
}

// One transition. `occupied` is the verdict at the CURRENT state: the cheap density in the coarse tier,
// the full density in the fine tier. The caller does the sampling; this function owns nothing but the
// schedule, which is why it is testable without a GPU.
CloudMarchState CloudMarchAdvance(CloudMarchState s, bool occupied, float tEnter, float minStep, float maxStep,
                                  float growth, float coarseMultiplier, int emptyBeforeCoarse)
{
    // Named `stride`, not `step`: GLSL has a built-in step() and a local of that name would hide it.
    float stride = CloudStepLength(s.T, minStep, maxStep, growth);
    float coarse = stride * max(coarseMultiplier, 1.0f);

    CloudMarchState next;
    next.T        = s.T;
    next.Frontier = s.Fine ? max(s.Frontier, s.T) : s.Frontier;
    next.EmptyRun = 0;
    next.Fine     = s.Fine;
    next.Shaded   = s.Shaded;

    if (!s.Fine)
    {
        if (occupied)
        {
            next.T      = max(max(tEnter, s.T - coarse), next.Frontier);
            next.Fine   = true;
            next.Shaded = false;
        }
        else
        {
            next.T = s.T + coarse;
        }
        return next;
    }

    if (occupied && !s.Shaded)
    {
        // Found while searching at the coarse rate: the leading edge lies within one coarse stride
        // behind this sample. Rewind to it — once, which `Shaded` guarantees — and resolve from there.
        next.T      = max(max(tEnter, s.T - coarse), s.Frontier);
        next.Shaded = true;
        return next;
    }

    int  run  = occupied ? 0 : (s.EmptyRun + 1);
    bool fine = run < max(emptyBeforeCoarse, 1);

    // A searching excursion advances at the coarse rate; a resolving one at the fine stride.
    next.T        = s.T + (s.Shaded ? stride : coarse);
    next.EmptyRun = fine ? run : 0;
    next.Fine     = fine;
    next.Shaded   = fine ? s.Shaded : false;
    return next;
}

// ---- Beer, powder, phase ---------------------------------------------------------------------------

// Beer-Lambert. The transmittance the march accumulates is a SEPARATE scalar initialised to 1 and only
// ever multiplied by this, so it is monotonically non-increasing and the early-out can be gated on it.
// The reference used one variable as both the scattered-light accumulator and the loop guard, which is
// why its early-out never fired (RESEARCH_REFERENCE J.3 #5).
float CloudBeerTransmittance(float opticalDepth)
{
    return exp(-max(opticalDepth, 0.0f));
}

// How much of a step's in-scattered light reaches the eye — the analytic integration of a source that is
// constant across the step through that step's own extinction (Hillaire's energy-conserving form).
//
// `scattering` is albedo * incoming light: the single-scattering albedo is sigma_s/sigma_t, so this is
// the source WITHOUT the scattering coefficient. Hillaire writes Sint = (S - S*exp(-sigma*dt))/sigma for
// an S that carries sigma_s; substituting S = sigma_t * scattering cancels the division, which is why
// there is no sigma in the denominator here and why writing one is such an easy mistake to make. It cost
// this renderer a factor of 1/sigma_t — and sigma_t is per centimetre, so that factor was ~5000 and every
// cloud saturated to flat white while its silhouette stayed correct.
//
// The property that makes that impossible to reintroduce quietly: the result is bounded by `scattering`.
// A step cannot scatter more light toward the eye than the source it is integrating.
vec3 CloudIntegrateInScatter(vec3 scattering, float sigma, float dt)
{
    float stepTransmittance = CloudBeerTransmittance(max(sigma, 0.0f) * max(dt, 0.0f));
    return scattering * (1.0f - stepTransmittance);
}

// The powder ("dark edge") term: thin cloud edges facing the sun are darker than Beer alone predicts
// because a single-scattering model cannot see the light that scattered out sideways.
float CloudPowder(float density, float strength, float scale)
{
    return 1.0f - clamp(strength, 0.0f, 1.0f) * exp(-max(scale, 0.0f) * max(density, 0.0f));
}

// Powder as the MARCH applies it: faded out as the view turns toward the sun (CLD-107). The dark edge is
// a reflection-side phenomenon — light that scattered away before it could come BACK — and the forward
// direction is where that lost light was going. Applying it there dimmed the one thing it cannot
// physically dim: the silver lining, which the in-scatter probability was already crushing from the
// other side.
//
// The ramp covers cosTheta in [0.85, 0.99] — the ~15-degree cone where the silver lining actually
// lives. The first version faded from 0.5 (a 60-degree cone), which protected the rim by also deleting
// powder from the whole backlit face: every inter-lobe crease on a cloud in front of the sun lost its
// darkening and the face rendered as flat white. The deck's own references (pp. 128-130) keep darker
// billow boundaries even fully backlit; only the rim itself is exempt.
float CloudPowderView(float density, float strength, float scale, float cosTheta)
{
    float powder = CloudPowder(density, strength, scale);
    return mix(powder, 1.0f, CloudRemapRange(cosTheta, 0.85f, 0.99f, 0.0f, 1.0f));
}

// Henyey-Greenstein, the published form. g = 0 is isotropic and returns 1/(4pi) for every angle.
//
// The reference passed g = 1.0 for its forward lobe, which makes the numerator (1 - g^2) exactly zero:
// the silver lining it was supposed to produce was not merely weak, it was identically absent
// (RESEARCH_REFERENCE J.3 #3). The component's range stops at 0.99 for that reason, and the max() below
// keeps the denominator away from zero at grazing angles rather than trusting the range.
float CloudHenyeyGreenstein(float cosTheta, float g)
{
    float g2 = g * g;
    float d  = 1.0f + g2 - 2.0f * g * cosTheta;
    return (1.0f - g2) / (4.0f * CLOUD_PI * pow(max(d, 1e-4f), 1.5f));
}

// Two lobes: a broad backward one that lifts the side of the sky away from the sun, and a narrow forward
// one that is the silver lining. SilverLiningIntensity multiplies the FORWARD lobe only — it is a rim
// control, and applying it to both would just be a brightness slider.
float CloudDualLobePhase(float cosTheta, float forwardG, float backwardG, float blend, float silver)
{
    float back = CloudHenyeyGreenstein(cosTheta, backwardG);
    float fwd  = CloudHenyeyGreenstein(cosTheta, forwardG) * max(silver, 0.0f);
    return mix(back, fwd, clamp(blend, 0.0f, 1.0f));
}

// In-scatter probability, the Nubis2 formulation, as a function of the NORMALIZED HEIGHT in the layer.
//
// The reference substituted the literal 0.5 for the height fraction in both terms, so its vertical
// gradient — the thing that makes a cloud base darker than its top — was a constant
// (RESEARCH_REFERENCE J.3 #4). `heightFraction` is the first argument here precisely so that mistake
// cannot be repeated silently: a caller that passes a constant is passing a constant on purpose.
float CloudInScatterProbability(float heightFraction, float densityLowLod, float opticalDepthToSun)
{
    float depthProbability = mix(0.05f + pow(clamp(densityLowLod, 0.0f, 1.0f),
                                             CloudRemapRange(heightFraction, 0.3f, 0.85f, 0.5f, 2.0f)),
                                 1.0f, clamp(opticalDepthToSun * 2.0f, 0.0f, 1.0f));
    float verticalProbability = pow(CloudRemapRange(heightFraction, 0.07f, 0.14f, 0.1f, 1.0f), 0.8f);
    return clamp(depthProbability * verticalProbability, 0.0f, 1.0f);
}

// The effective extinction a MULTIPLY-SCATTERED estimate integrates with, which is not the medium's own.
//
// Nubis3 p.136 is the ablation that names this: p.135 renders a dense backlit cumulus with the direct
// extinction alone and the core comes out charcoal-black; p.136 is the same cloud, luminous, and the only
// difference is the line
//
//     ms_volume *= exp(-inSunLightSummedDensitySamples *
//                      Remap(sun_dot, 0.0, 0.9, 0.25, ValueRemap(cloud_distance, -128.0, 0.0, 0.05, 0.25)));
//
// Two modulations in one expression. The inner one is DEPTH: at the cloud's surface (cloud_distance 0)
// the coefficient is 0.25, and at the far end of the reference's -128..0 distance range it is 0.05 — a
// fifth — because light that has already bounced several times arrives from every direction and no longer
// cares about the beam's own path. The outer one is VIEW ANGLE:
// the reduction is handed out in full only when the eye looks along the sun's direction (sun_dot -> 0.9),
// which is exactly the backlit case the ablation is about, and is absent when the eye looks away from the
// sun (sun_dot -> 0), where the lit face is already the brightest thing in the frame and any further
// reduction would only blow it out.
//
// The reference indexes depth by an SDF into a voxelised cloud, which a procedural field 150 km across does
// not have. The deepest field we do have is the unerroded PROFILE — a sample with profile near 1 is deep
// inside the modelled cloud by construction, and it is what the paper's own ambient formula is already
// built on (p. 141). Its range maps onto the reference's -128..0 with the sign flipped: profile 0 IS the
// surface, profile 1 IS the core.
//
// The same pair of constants drives the ambient column below (CLD-104) — one number, one place, because
// they are the same physical claim measured on the same page.
const float CLOUD_MS_EXTINCTION_SURFACE = 0.25f;
const float CLOUD_MS_EXTINCTION_CORE    = 0.05f;

// OUR DIMENSIONAL PROFILE IS NOT THE REFERENCE'S, and both formulas the deck keys on "profile" were
// written for the reference's meaning. Nubis3's dimensional profile is an AUTHORED voxel field (pp.
// 82-86): 1 throughout a cloud's interior, with a soft falloff over the last voxel or two of its
// surface. Ours is the Vertical Profile Method's product of three smooth [0,1] factors — envelope x
// coverage x base shape (CloudDensityProcedural.glslh:154-162) — and it is SMALL exactly where the eye
// looks, because the eye's own transmittance dies within a few hundred metres of the surface, long
// before the envelope has climbed anywhere near its peak.
//
// Measured on this renderer rather than argued: the raymarch was made to write the contribution-weighted
// mean profile of each ray into the frame and threshold it. Over Clouds_UEShowcase and Clouds_Sunset the
// samples the eye actually integrates sit at 0.06-0.20, only isolated cores pass 0.20, and essentially
// nothing reaches 0.30.
//
// So both depth-keyed formulas were being evaluated in the bottom fifth of their domain and came out as
// near-identity. At profile 0.1, p.136 yields an effective extinction of 0.23 where its core case is
// 0.05 — an 8% reduction of the sun optical depth instead of 80% — and p.141 yields sqrt(1 - 0.1) =
// 0.95, i.e. 5% occlusion where the reference's interior gets 100%. That is the whole reason CLD-113
// measured +0.1 luma, and the reason Ambient Occlusion could be raised without darkening anything: the
// strength was scaling a factor that was already 1.
//
// This is the ONE place that conversion is made, and both formulas below go through it.
// CLOUD_PROFILE_INTERIOR is the profile value at which our field reads as cloud INTERIOR rather than as
// surface skin — the measured core threshold above. It belongs to the density model, not to a preset:
// coverage and erosion move the realised values somewhat, and being off by a factor here softens or
// strengthens the two formulas rather than breaking either. It is deliberately NOT a slider; a knob
// here would be a second calibration of a quantity that already has one.
const float CLOUD_PROFILE_INTERIOR = 0.20f;

// The reference's dimensional profile, given ours. 0 IS the surface and 1 IS the interior, which is the
// domain p.136's ValueRemap and p.141's pow(1 - profile, 0.5) are both written against.
float CloudProfileDepth(float profile)
{
    return clamp(profile * (1.0f / CLOUD_PROFILE_INTERIOR), 0.0f, 1.0f);
}

// @p profile is the UNERRODED dimensional profile in [0,1]; @p cosTheta is the view/sun angle cosine, 1
// when the eye looks straight at the sun.
float CloudMultiScatterExtinction(float profile, float cosTheta)
{
    float deep = mix(CLOUD_MS_EXTINCTION_SURFACE, CLOUD_MS_EXTINCTION_CORE, CloudProfileDepth(profile));
    return CloudRemapRange(cosTheta, 0.0f, 0.9f, CLOUD_MS_EXTINCTION_SURFACE, deep);
}

// The optical depth the multiple-scattering octaves should actually see, given what the sun march measured.
//
// Expressed as the RATIO to the surface coefficient rather than as the coefficient itself, and that is the
// whole of why this can land without re-authoring every preset: our tauSun already carries whatever
// calibration ExtinctionScale and the cone march were tuned to, and the reference's 0.25 is what that
// tuning corresponds to — a cloud edge. So the multiplier is exactly 1 at profile 0 and exactly 1 for any
// view that does not face the sun, and the deepest backlit sample gets 0.05/0.25 = one fifth of the optical
// depth, which is the reference's own ratio and nothing else.
float CloudMultiScatterOpticalDepth(float opticalDepthToSun, float profile, float cosTheta)
{
    return max(opticalDepthToSun, 0.0f) *
           (CloudMultiScatterExtinction(profile, cosTheta) / CLOUD_MS_EXTINCTION_SURFACE);
}

// ---- Transmittance at depth ------------------------------------------------------------------------

// The MEAN COSINE of a cloud droplet's phase function at visible wavelengths. Mie scattering off a
// typical cumulus size distribution gives g ~ 0.85, and that is a property of water droplets rather than
// a rendering choice: it is what decides how far light diffuses into a cloud, whatever two-lobe fit the
// phase functions above use to draw the single-scattering lobes. Named here so the diffusion coefficient
// below is a measured quantity and not a curve somebody liked.
const float CLOUD_DROPLET_ASYMMETRY = 0.85f;

// Beer's law is the WRONG SHAPE deep inside a cloud, and the octave chain inherits its shape.
//
// The chain (below) attenuates octave i with exp(-tau * a^i). Every term is an exponential, so the whole
// estimate has an exponential floor: at the shipped three octaves and 0.5 falloff, an optical depth of
// 50 toward the sun leaves 0.25 * exp(-12.5) = 9e-7 of the sun's light — that is what renders a
// cumulonimbus interior as a hole rather than as the luminous mass of Nubis3 pp. 137/142. Deck p.136 is
// the same observation from the authoring side: it drives the effective extinction of the
// multiple-scattering term from 0.25 at the surface down to 0.05 in the core, and CloudMultiScatterExtinction
// above ports that. But a fifth of an exponential is still an exponential, and 0.05 * 50 = 2.5 nepers is
// still a factor of twelve.
//
// A STRONGLY SCATTERING SLAB DOES NOT DECAY EXPONENTIALLY. For a conservatively scattering medium the
// diffusion approximation gives a transmittance that falls ALGEBRAICALLY with thickness,
//
//     T(tau) = 1 / (1 + (3/4) * (1 - g) * tau)
//
// (the classical two-stream / similarity result: the (1 - g) factor is the reduction to an equivalent
// isotropic medium, and the 3/4 is the diffusion constant). At g = 0.85 and tau = 50 that is 0.15 —
// five orders of magnitude above what the chain gives, and it is the difference between a core that
// glows and a core that is a silhouette.
//
// The two descriptions own different regimes and the join is where the beam stops being a beam: Beer's
// law is exact for the UNSCATTERED beam, and by definition the first scattering event happens at one
// optical depth. Below one mean free path the answer is unchanged, bit for bit, so every thin cloud,
// every rim and every edge in every scene renders exactly as it did. Above it, the tail is the diffusion
// shape, anchored to Beer's own value at the join so the function is continuous:
//
//     T(tau) = exp(-tau)                                        tau <= 1
//            = exp(-1) * (1 + k) / (1 + k * tau)                tau >  1,  k = (3/4)(1 - g)
//
// WHAT THIS DOES NOT REACH, stated because a measured shortfall is worth more than a claim. Anchoring
// the tail to Beer at the join costs the amplitude: the chain's normalised transmittance comes out at
// about 0.6 of the diffusion asymptote over tau 50-100 rather than at it. Closing that last factor would
// mean re-deriving the octave weights themselves, which is a bigger change than this one and would move
// every preset. What it does deliver is the SHAPE — algebraic, not exponential — which is worth 1e5 at
// tau 50, and the tests pin both the shape and the shortfall so neither can drift quietly.
const float CLOUD_DIFFUSION_JOIN_TAU = 1.0f;

float CloudThickTransmittance(float opticalDepth)
{
    float tau = max(opticalDepth, 0.0f);
    if (tau <= CLOUD_DIFFUSION_JOIN_TAU)
        return exp(-tau);

    float k = 0.75f * (1.0f - CLOUD_DROPLET_ASYMMETRY);
    float a = exp(-CLOUD_DIFFUSION_JOIN_TAU) * (1.0f + k * CLOUD_DIFFUSION_JOIN_TAU);
    return a / (1.0f + k * tau);
}

// Per channel, because ExtinctionTint is per channel and the optical depth each channel sees is its own.
vec3 CloudThickTransmittance3(float opticalDepth, vec3 extinctionTint)
{
    return vec3(CloudThickTransmittance(opticalDepth * extinctionTint.x),
                CloudThickTransmittance(opticalDepth * extinctionTint.y),
                CloudThickTransmittance(opticalDepth * extinctionTint.z));
}

// Multiple scattering, approximated by N octaves with geometric falloff (Wrenninge et al. / Schneider).
// Octave i attenuates with extinction^(a^i), contributes scatter^(b^i) and flattens its phase by c^i.
// It costs arithmetic, not samples: the optical depth is the one already marched toward the sun, so a
// higher octave count never traces another ray. Single scattering alone leaves thick cloud cores black.
//
// Per-channel, because ExtinctionTint is per-channel: a cloud thick enough to matter is where the small
// colour shift through thickness is visible at all.
vec3 CloudMultiScatter(float opticalDepthToSun, vec3 extinctionTint, float cosTheta, int octaves,
                       float extinctionFalloff, float scatterFalloff, float phaseFalloff, float forwardG,
                       float backwardG, float blend, float silver)
{
    vec3  total         = vec3(0.0f, 0.0f, 0.0f);
    float extinctionMul = 1.0f;
    float scatterMul    = 1.0f;
    float phaseMul      = 1.0f;
    int   octaveCount   = clamp(octaves, 1, 8);

    for (int i = 0; i < octaveCount; ++i)
    {
        float phase = CloudDualLobePhase(cosTheta, forwardG * phaseMul, backwardG * phaseMul, blend, silver);
        // Not exp(): see CloudThickTransmittance. Identical to exp() for every octave whose own optical
        // depth is under one mean free path, which is every octave of every thin cloud in every scene.
        vec3 beer = CloudThickTransmittance3(max(opticalDepthToSun * extinctionMul, 0.0f), extinctionTint);
        total = total + beer * (scatterMul * phase);
        extinctionMul *= extinctionFalloff;
        scatterMul *= scatterFalloff;
        phaseMul *= phaseFalloff;
    }
    return total;
}

// ---- The cone march toward the sun -----------------------------------------------------------------
//
// The reference pre-integrates density toward the sun into a 256x256x32 voxel grid sized for a 2 km box,
// and marches it AWAY from the sun (RESEARCH_REFERENCE J.3 #2), so its self-shadowing comes from the
// wrong side. Over a 150 km cloudscape that grid is meaningless anyway. What replaces it is a short cone
// march along the actual sun direction, defined here so that "which way does it go" is a testable fact
// rather than a sign somewhere in a loop.

// Distance from the shaded sample to the i-th cone SEGMENT BOUNDARY, in world units. Exponential rather
// than uniform: the first samples resolve the terminator on this cloud, the last one reaches far enough
// to be shadowed by the next cloud over.
float CloudConeBoundary(int i, int count, float marchDistance)
{
    float t = float(i) / float(max(count, 1));
    // (e^2t - 1)/(e^2 - 1): 0 at t=0, 1 at t=1, and about four times denser at the near end.
    return marchDistance * (exp(2.0f * t) - 1.0f) / (exp(2.0f) - 1.0f);
}

// Length the i-th sample stands for. Multiplying the sampled density by this is what turns a set of
// point samples into an optical DEPTH — the reference omitted the step length entirely.
// Upper bound on the cone-march sample count, matching the Light March Samples property's Range(1, 16).
// The raymarch builds the cone table once per ray into fixed-size arrays, and this is their size.
#define CLOUD_MAX_LIGHT_MARCH_SAMPLES 16

float CloudConeSampleWeight(int i, int count, float marchDistance)
{
    return CloudConeBoundary(i + 1, count, marchDistance) - CloudConeBoundary(i, count, marchDistance);
}

// Offset of the i-th cone sample from the shaded point, in world units.
//
// The along-sun component is the midpoint of the segment and is always POSITIVE, so every sample lies
// toward the sun by construction — the property the test asserts. The lateral component is a
// golden-angle spiral in the plane orthogonal to the sun, widening with distance, which is what softens
// a self-shadow terminator that a single straight ray renders as a hard line. `spread` = 1 opens the
// cone to a 45-degree half-angle at the far end.
vec3 CloudConeSampleOffset(vec3 sunDir, int i, int count, float marchDistance, float spread)
{
    float r = 0.5f * (CloudConeBoundary(i, count, marchDistance) + CloudConeBoundary(i + 1, count, marchDistance));
    float t = ( float(i) + 0.5f ) / float(max(count, 1));

    // A basis orthogonal to the sun. The reference axis is swapped near the poles because cross() with a
    // nearly parallel vector loses all its precision, and a zero-length tangent is a NaN sample.
    vec3 reference = abs(sunDir.y) < 0.99f ? vec3(0.0f, 1.0f, 0.0f) : vec3(1.0f, 0.0f, 0.0f);
    vec3 tangentX  = normalize(cross(reference, sunDir));
    vec3 tangentY  = cross(sunDir, tangentX);

    float angle  = float(i) * 2.399963229728653f; // golden angle, radians
    float radius = r * clamp(spread, 0.0f, 1.0f) * sqrt(t);

    return sunDir * r + (tangentX * cos(angle) + tangentY * sin(angle)) * radius;
}

// ---- Closing out a ray that ran out of budget ------------------------------------------------------

// What a ray has when MaxSteps runs out before it left the shell or went opaque, and what to do with it.
//
// The old answer was to DELETE the difference: transmittance was pushed back toward 1 and the
// accumulated radiance scaled down by the square of the untravelled fraction. That is the wrong sign in
// both terms — a ray that ran out of budget has integrated too LITTLE cloud, not too much — and because
// the fraction is a function of where the budget happened to run out, two neighbouring pixels that
// exhausted at different places got visibly different answers. On Clouds_UEShowcase it read as dark
// vertical drips hanging under every tall mass and as a sky far emptier than the density field.
//
// What replaces it is the cheapest honest statement available: the part of the shell that was NOT
// marched looks, on average, like the part that WAS. The ray already knows its own mean extinction —
// the density-length it accumulated over the distance it covered — and its own mean radiance per unit
// of opacity, which is the premultiplied `scattered` divided by the opacity it has so far. One analytic
// Beer step over the remaining distance closes the ray out with both.
//
// ENERGY BOUND, which is what the test pins: the tail adds at most `transmittance * meanRadiance`, so
// the closure can never brighten a ray beyond the radiance it measured, and transmittance only falls.
struct CloudRayTail
{
    vec3  Scattered;
    float Transmittance;
};

CloudRayTail CloudCloseExhaustedRay(vec3 scattered, float transmittance, float densityLength,
                                    float marchedDistance, float remainingDistance, float sigmaScale)
{
    CloudRayTail tail;
    tail.Scattered     = scattered;
    tail.Transmittance = transmittance;

    if (remainingDistance <= 0.0f || marchedDistance <= 0.0f)
        return tail;

    float meanDensity = max(densityLength, 0.0f) / marchedDistance;
    float tauTail     = meanDensity * max(sigmaScale, 0.0f) * remainingDistance;
    float tailTrans   = CloudBeerTransmittance(tauTail);

    // Premultiplied radiance over the opacity that produced it: the mean radiance the ray has seen. A
    // ray with no opacity yet has no estimate and the max() leaves it alone rather than dividing by zero.
    float opacity = 1.0f - clamp(transmittance, 0.0f, 1.0f);
    vec3  mean    = opacity > 1e-4f ? scattered * (1.0f / opacity) : vec3(0.0f, 0.0f, 0.0f);

    tail.Scattered     = scattered + mean * (clamp(transmittance, 0.0f, 1.0f) * (1.0f - tailTrans));
    tail.Transmittance = clamp(transmittance, 0.0f, 1.0f) * tailTrans;
    return tail;
}

// ---- Ambient ---------------------------------------------------------------------------------------

// The ambient a cloud sample receives: the sky from above and the ground bounce from below, leaning
// toward one or the other by where the sample sits in the layer.
//
// heightBias = 0 removes the height dependence entirely (an even split, which is what a flat overcast
// wants); heightBias = 1 hands the blend to the height fraction, so the top of a cloud is lit by sky and
// its base by ground. The component contributes MULTIPLIERS ONLY — the two radiances come from the
// atmosphere, evaluated through the same model the visible sky uses, so a cloud cannot disagree with the
// sky it hangs in about what time of day it is.
vec3 CloudAmbient(vec3 skyRadiance, vec3 groundRadiance, float skyMultiplier, float groundMultiplier,
                  float heightBias, float heightFraction)
{
    float blend = mix(0.5f, clamp(heightFraction, 0.0f, 1.0f), clamp(heightBias, 0.0f, 1.0f));
    return mix(groundRadiance * groundMultiplier, skyRadiance * skyMultiplier, blend);
}

// How much of the sky a sample can actually SEE — the occlusion of the ambient term.
//
// Nubis3 (SIGGRAPH 2023, pp. 141 and 144) writes it as
//     ambient_scattering = pow(1 - dimensional_profile, 0.5) * exp(-summed_ambient_density)
// and the two halves do different jobs. The first is LOCAL: a sample in dense material has cloud pressed
// against it on every side and sees almost no sky, while a wisp on the rim sees all of it. The second is
// the COLUMN: everything stacked overhead, which is what makes a cloud base dark while its top stays
// bright.
//
// Without them every sample in a cloud receives the full sky and ground radiance no matter how deep it
// sits, and a three-kilometre core is lit exactly as brightly as a rim wisp. That is the difference
// between a volume and a slab, and it is what the paper's own ablation (pp. 133-136) is about: it is not
// a subtlety, it is most of why a cloud reads as three-dimensional at all.
//
// @p density is the sample's own [0,1] density; @p columnDensityLength is the density-length stacked
// above it, in the same units the sun march accumulates, or zero where nothing has measured it.
// SKY LIGHT IS NOT A COLLIMATED BEAM, and the extinction it sees is not the sun's. Nubis3 makes the same
// point from the other side (p. 136): its multiple-scattering term drives the effective extinction down to
// between a quarter and a twentieth of the direct one, precisely because light that has already bounced
// penetrates far deeper than light that has not. Applying the full sun extinction to the column here is
// what turns cloud cores black instead of luminous — the paper's own ablation, pp. 135 vs 136.
//
// @p strength blends the whole thing back toward unoccluded — the knob that says how literally to take
// the occlusion model.
//
// The column's extinction is DEPTH-MODULATED (CLD-104) by the same p.136 pair the direct term uses —
// CLOUD_MS_EXTINCTION_SURFACE / _CORE, defined once above with the reasoning. Sky light is the term the
// argument applies to most obviously: it has bounced by definition, so it penetrates a core the sun's own
// beam cannot reach. A constant 0.25 was the previous stand-in, and it darkened exactly the thick
// interiors the modulation exists to keep lit.
//
// There is NO view-angle factor here, and that is deliberate rather than an omission: p.136's outer
// Remap(sun_dot, ...) exists because the direct term is a beam from one direction. Ambient arrives from
// the whole sky, so it has no angle to be modulated by.

// @p profile is the UNERRODED dimensional profile (the cheap density), per Nubis3 p.141 — the eroded
// density goes to zero on every wisp the erosion carved, and ambient occlusion driven by it lit the
// carved faces of a dense cloud as if they were rim wisps.
float CloudAmbientOcclusion(float profile, float columnDensityLength, float sigmaScale, float strength)
{
    // Through CloudProfileDepth, for the reason spelled out where it is defined: p.141's curve is written
    // against a field that saturates at 1 inside a cloud, and ours reaches 0.06-0.20 there.
    float p      = CloudProfileDepth(profile);
    float local  = sqrt(max(1.0f - p, 0.0f));
    float k      = mix(CLOUD_MS_EXTINCTION_SURFACE, CLOUD_MS_EXTINCTION_CORE, p);
    float column = exp(-max(columnDensityLength, 0.0f) * max(sigmaScale, 0.0f) * k);
    return mix(1.0f, local * column, clamp(strength, 0.0f, 1.0f));
}

// The shadow tint a sample actually receives (CLD-105): the authored tint weighted by how OCCLUDED the
// sample is from the sun, so it means what its name says. At tauSun = 0 — a fully lit face — the tint
// is identity; deep in shadow it is the authored colour in full. Multiplying ALL ambient by the tint,
// which is what the march used to do, was a global colour cast wearing a shadow control's name.
vec3 CloudShadowTintWeight(vec3 tint, float tauSun)
{
    float occlusion = 1.0f - exp(-max(tauSun, 0.0f));
    return mix(vec3(1.0f, 1.0f, 1.0f), tint, occlusion);
}

// Projects a density-length accumulated along the SUN ray onto the VERTICAL (CLD-103). Sky-visibility
// occlusion is about the stack OVERHEAD (Nubis3 p.144 sums it along up), but the only column we have
// pre-integrated is the shadow map's, which runs along the sun. For a layer-shaped cloud field the slant
// path exceeds the vertical one by 1/sin(elevation), so multiplying by sin projects it back — clamped
// below so a sunrise sun cannot claim the vertical column is nearly zero. Without this, ambient
// darkened by the SLANT depth: over-darkened at exactly the low sun angles where the direct light has
// already gone, and asymmetrically on the sun-far side — an anisotropy sky light does not have.
float CloudAmbientColumnVertical(float sunColumnLength, float sunDirY)
{
    return max(sunColumnLength, 0.0f) * clamp(sunDirY, 0.15f, 1.0f);
}

// Where the aerial-perspective and horizon fades should START and END when nobody has authored them.
//
// Authoring them in kilometres does not survive contact with the geometry. Both fades are measured along
// the ray, and a ray's distance to the layer grows as 1/sin(elevation) — so a range of 50 to 140 km, which
// sounds like "the far half of the sky", is in fact the band between 1.9 and 0.6 degrees above the
// horizon. Every cloud higher than two degrees got no aerial perspective at all, which is why a cloud
// forty kilometres away was as white and as crisp as one four kilometres away.
//
// Tied to the layer instead: the fade begins a couple of layer-heights out, where a ray has travelled
// enough air for it to matter, and ends at the layer's own geometric horizon, sqrt(2*R*h) — the distance
// at which the layer meets the ground plane and there is nothing further to fade. For a 1.5 km base that
// is 3 km to 138 km, which spreads the effect from about thirty degrees down to the horizon instead of
// compressing it into the last degree.
float CloudAutoFadeStart(float layerBottomAltitude)
{
    return max(2.0f * layerBottomAltitude, 1.0f);
}

float CloudAutoFadeEnd(float planetRadius, float layerBottomAltitude, float layerThickness)
{
    float top = max(layerBottomAltitude + layerThickness, 1.0f);
    return sqrt(2.0f * max(planetRadius, 1.0f) * top);
}

// ---- Aerial perspective ----------------------------------------------------------------------------

// The air between the eye and the cloud, composed onto the cloud's own radiance.
//
// This is UE's SAMPLE_ATMOSPHERE_ON_CLOUDS arrangement (Docs/Sky/UE_SKYATMOSPHERE_RESEARCH.md section
// 1.4) and it has exactly two terms, each answering a different question:
//   * the cloud's radiance is ATTENUATED by @p apTransmittance, because that light had to cross the air
//     to reach the camera;
//   * the air's own in-scattered light is ADDED over 1 - @p cloudTransmittance, the fraction of the pixel
//     the cloud actually covers. Not over the whole pixel: where the cloud is transparent the sky pass
//     already drew that direction's full atmospheric column, and adding the froxel there would be the
//     same air counted twice — which reads as a bright halo around every cloud edge.
//
// @p strength is the authored Atmospheric Perspective dial over the WHOLE coupling: 0 leaves the cloud's
// own light exactly as the march produced it, 1 is the physical composition unmodified. Blending the
// composed result rather than scaling the froxel keeps the two terms consistent with each other at every
// setting — scaling only the in-scatter would brighten a cloud that the same air is supposed to be
// dimming.
//
// ENERGY BOUND, which is what the test pins: for a transmittance in [0,1] and a non-negative froxel the
// result can never exceed scattered + apLuminance, so no setting of the dial can invent light.
vec3 CloudApplyAerialPerspective(vec3 scattered, float cloudTransmittance, vec3 apLuminance,
                                 float apTransmittance, float strength)
{
    float coverage = 1.0f - clamp(cloudTransmittance, 0.0f, 1.0f);
    vec3  composed = scattered * clamp(apTransmittance, 0.0f, 1.0f) + apLuminance * coverage;
    return mix(scattered, composed, clamp(strength, 0.0f, 1.0f));
}

// ---- Scene depth -----------------------------------------------------------------------------------

// Distance from the camera to the geometry the depth buffer recorded, in WORLD UNITS.
//
// Reconstructed through the camera's own inverse view-projection rather than through a hand-derived
// linearisation, so it holds whatever near/far planes and whatever depth convention the projection was
// built with; the test proves it by round-tripping a point through the engine's real projection matrix.
// `deviceDepth` is the value stored in the depth attachment and `ndc` is the pixel in [-1,1]^2.
float CloudDistanceFromDepth(mat4 invViewProj, vec3 cameraPos, vec2 ndc, float deviceDepth)
{
    vec4 clip  = vec4(ndc.x, ndc.y, deviceDepth, 1.0f);
    vec4 world = invViewProj * clip;
    return length(vec3(world.x, world.y, world.z) / max(world.w, 1e-9f) - cameraPos);
}

// Where the march has to stop. Depth clears to 1.0 (RenderPass.hpp), i.e. "nothing was drawn here", and
// that pixel is sky all the way to MaxViewDistance rather than geometry at the far plane. This is the
// ONE occlusion path: it works identically in Forward and Deferred because it reads the depth
// attachment both paths write, not a G-buffer only one of them has.
float CloudGeometryLimit(mat4 invViewProj, vec3 cameraPos, vec2 ndc, float deviceDepth, float maxViewDistance)
{
    if (deviceDepth >= 1.0f)
        return maxViewDistance;
    return min(CloudDistanceFromDepth(invViewProj, cameraPos, ndc, deviceDepth), maxViewDistance);
}

#endif // CLOUD_GEOMETRY_GLSLH
