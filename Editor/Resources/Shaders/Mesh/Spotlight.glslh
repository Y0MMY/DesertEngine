#ifndef SPOTLIGHT_GLSLH
#define SPOTLIGHT_GLSLH

#include "PBRFunctions.glslh"

// std430 layout — must match ShaderProtocols::SpotLightPayload (64 bytes).
struct SpotLight {
    vec3  color;
    float intensity;
    vec3  position;
    float range;
    vec3  direction;   // normalized, pointing OUT of the cone apex
    float cosInner;    // cos(inner half-angle) — full intensity inside this
    float cosOuter;    // cos(outer half-angle) — zero intensity outside this
    int   falloff;     // LightFalloff: 0=Linear, 1=Quadratic, 2=InverseSquare
    vec2  _pad;
};

// Unbounded storage buffer — no cap. Count from LightsMetadata.SpotLightCount.
layout(std430, binding = 16) readonly buffer SpotLightsUB
{
    SpotLight spotLights[];
};

// Cone angular falloff: 1 inside the inner cone, smooth to 0 between inner and outer, 0 outside.
float SpotConeFactor(SpotLight light, vec3 L)
{
    // L points from the surface TOWARD the light; the cone opens along -direction from the light.
    float cosTheta = dot(-L, light.direction);
    return clamp((cosTheta - light.cosOuter) / max(light.cosInner - light.cosOuter, 1e-4), 0.0, 1.0);
}

vec3 CalculateSpotLight(SpotLight light, vec3 worldPosition, vec3 view, vec3 N, vec3 F0, float metalness, float roughness, vec3 albedo)
{
    vec3  L    = light.position - worldPosition;
    float distance = length(L);
    L = normalize(L);

    float cone = SpotConeFactor(light, L);
    if (cone <= 0.0)
        return vec3(0.0);

    vec3 H = normalize(view + L);

    float cosLi = max(dot(N, L), 0.0);
    float cosLh = max(dot(N, H), 0.0);
    float cosLo = max(dot(N, view), 0.0);

    if (cosLi <= 0.0)
        return vec3(0.0);

    float attenuation = LightFalloffFactor(distance, 0.0, light.range, light.falloff) * cone;
    vec3  radiance    = light.color * light.intensity * attenuation;

    float D   = DistributionGGX(cosLh, roughness);
    float Vis = VisibilitySmith(cosLi, cosLo, roughness);
    vec3  F   = fresnelSchlick(F0, max(dot(H, view), 0.0));

    vec3 specular = D * Vis * F;
    vec3 kd       = (1.0 - F) * (1.0 - metalness);
    vec3 diffuse  = kd * albedo / PI;

    return (diffuse + specular) * radiance * cosLi;
}

// Scalar "how much this spot light lands here" for the lighting debug view.
float SpotLightContribution(SpotLight light, vec3 worldPosition, vec3 N)
{
    vec3  L    = light.position - worldPosition;
    float dist = length(L);
    L = normalize(L);
    float cone = SpotConeFactor(light, L);
    float cosLi = max(dot(N, L), 0.0);
    if (cone <= 0.0 || cosLi <= 0.0) return 0.0;
    float attenuation = LightFalloffFactor(dist, 0.0, light.range, light.falloff) * cone;
    return attenuation * cosLi * light.intensity;
}

#endif // SPOTLIGHT_GLSLH
